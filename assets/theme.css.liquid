  font-weight: 500;
}
@media only screen and (max-width: 749px) {
  .collection-item__info span.collection-item__info-item-description {
    font-size: 14px;
  }
}

@media (hover: hover) {
  .collection-item:hover .collection-item__info span {
    background-size: var(--bg-size);
  }
}
