    display: none;
  }
}

.pagination-custom a {
  transition: color 0.3s ease;
}
.pagination-custom a:hover, .pagination-custom a:focus {
  color: var(--text-hover);
}

.pagination-custom__page {
  --link: var(--text);
  margin: 0 12px;
