{% comment %}
{% render 'image-metafields', image: , class_name: , image_attr: , show_id , alt: alt, small_size: boolean, preload: boolean  %}
{% endcomment %}

{%- if preload -%}
	<link rel="preload" href="{{ image.cloudinary_src | append: 'w_360' }}" as="image"
				imagesrcset="
     {%- if small_size -%}
       {{ image.cloudinary_src | append: 'w_25' }} 25w,
       {{ image.cloudinary_src | append: 'w_36' }} 36w,
       {{ image.cloudinary_src | append: 'w_72' }} 72w,
       {{ image.cloudinary_src | append: 'w_144' }} 144w,
			 {{ image.cloudinary_src | append: 'w_240' }} 240w,
			 {{ image.cloudinary_src | append: 'w_360' }} 360w,
     {%- endif -%}
	    {{ image.cloudinary_src | append: 'w_540' }} 540w,
	    {{ image.cloudinary_src | append: 'w_720' }} 720w,
	    {{ image.cloudinary_src | append: 'w_900' }} 900w,
	    {{ image.cloudinary_src | append: 'w_1080' }} 1080w,
	    {{ image.cloudinary_src | append: 'w_1296' }} 1296w,
	    {{ image.cloudinary_src | append: 'w_1350' }} 1350w,
	    {{ image.cloudinary_src | append: 'w_1512' }} 1512w,
	    {{ image.cloudinary_src | append: 'w_1728' }} 1728w,
	    {{ image.cloudinary_src | append: 'w_1920' }} 1920w,
	    {{ image.cloudinary_src | append: 'w_2560' }} 2560w">
{%- endif -%}

{%- assign alt = alt | default: image.alt | escape -%}

<img {% if show_id and image.id != blank %}id="{{ image.id }}"{% endif %}
		 src="{{ image.cloudinary_src | append: 'w_1' }}"
		 srcset="
     {%- if small_size -%}
       {{ image.cloudinary_src | append: 'w_25' }} 25w,
       {{ image.cloudinary_src | append: 'w_36' }} 36w,
       {{ image.cloudinary_src | append: 'w_72' }} 72w,
       {{ image.cloudinary_src | append: 'w_144' }} 144w,
			 {{ image.cloudinary_src | append: 'w_240' }} 240w,
			 {{ image.cloudinary_src | append: 'w_360' }} 360w,
     {%- endif -%}
	    {{ image.cloudinary_src | append: 'w_540' }} 540w,
	    {{ image.cloudinary_src | append: 'w_720' }} 720w,
	    {{ image.cloudinary_src | append: 'w_900' }} 900w,
	    {{ image.cloudinary_src | append: 'w_1080' }} 1080w,
	    {{ image.cloudinary_src | append: 'w_1296' }} 1296w,
	    {{ image.cloudinary_src | append: 'w_1350' }} 1350w,
	    {{ image.cloudinary_src | append: 'w_1512' }} 1512w,
	    {{ image.cloudinary_src | append: 'w_1728' }} 1728w,
	    {{ image.cloudinary_src | append: 'w_1920' }} 1920w,
	    {{ image.cloudinary_src | append: 'w_2560' }} 2560w"
		 class="{{ class_name }}"
		 loading="lazy"
		 data-sizes="auto"
		 data-optimumx="auto"
		 data-src="{{ image.cloudinary_src | append: 'w_360' }}"
		 data-parent-fit="contain"
		 alt="{{ alt }}"
		 width="100%"
		 height="100%"
	{{ image_attr }}>