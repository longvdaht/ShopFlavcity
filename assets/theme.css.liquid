  /* // TODO: delete next JudgeMe CSS after launch  */
  /* // and make all these changes from admin if possible */
}
.tabs-collections .product-item .grid__heading-holder {
  overflow: hidden;
}
.product-item quick-add-product {
  display: flex;
  padding: 0 16px 30px;
