.collection__sidebar__slide-out .collection__sidebar {
  flex-grow: 1;
  height: auto;
  overflow-y: auto;
}

.collection__products .underlay {
  z-index: 6000;
  -webkit-backface-visibility: hidden;
          backface-visibility: hidden;
}

.collection__active__filters {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: 10px;
}

.active__filters__clear,
.active__filters__remove {
  --link: var(--text);
  display: flex;
  background-color: var(--bg-accent);
  padding: 8px 7px 8px 14px;
  margin: 0 7px 7px 0;
  font-size: var(--font-body-x-small);
}
.active__filters__clear:hover,
.active__filters__remove:hover {
  color: var(--text-dark);
}
.active__filters__clear:hover .filter__x,
.active__filters__remove:hover .filter__x {
  color: var(--accent);
}
.active__filters__clear small,
.active__filters__remove small {
  align-self: center;
  flex: 0 1 100%;
  overflow-wrap: break-word;
  font-size: inherit;
}

.filter__x {
  --icon-size: 14px;
  flex: 0 0 auto;
  font-weight: var(--FONT-WEIGHT-BODY-BOLD);
  margin-left: 4px;
}

.active__filters__clear {
  padding-right: 14px;
  font-weight: var(--FONT-WEIGHT-BODY-BOLD);
}

.filter__price {
  margin-top: 12px;
}

.filter__price__fields {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  max-width: 100%;
  margin: 0 0 25px;
}

.filter__price__fields label {
  position: absolute !important;
  overflow: hidden;
  -webkit-clip-path: rect(0 0 0 0);
          clip-path: rect(0 0 0 0);
  height: 1px;
  width: 1px;
  margin: -1px;
  padding: 0;
  border: 0;
}

.filter__price__field {
  display: flex;
  align-items: center;
  flex: 1;
  max-width: calc(50% - 10px);
  padding: 8px 0 8px 8px;
  border: 1px solid var(--text);
  border-radius: var(--RADIUS-SELECT);
}

.filter__price__currency {
  margin-right: 5px;
}

.filter__price__spacer {
  flex: 0 0 20px;
  position: relative;
  padding: 5px;
  font-size: 0;
  text-align: center;
}
.filter__price__spacer::before {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 6px;
  height: 1px;
  margin-left: -3px;
  background: currentcolor;
  content: "";
}

.filter__price__input {
  flex: 1;
  display: block;
  min-width: 0;
  max-width: 100%;
  width: 0;
  padding: 0 3px;
  border: 1px solid transparent;
  border-radius: 0;
  margin: 0;
  font-family: inherit;
  font-size: inherit;
  font-weight: inherit;
  text-align: right;
}

.range {
  position: relative;
  display: block;
  height: 36px;
  margin-left: -8px;
  margin-right: -8px;
  opacity: 0;
  -webkit-user-select: none;
          user-select: none;
}

.range.is-initialized {
  opacity: 1;
}

.range__dot {
  position: absolute;
  z-index: 2;
  display: block;
  width: 36px;
  height: 36px;
  padding: 8px;
}
.range__dot span {
  display: block;
  width: 100%;
  height: 100%;
  background: var(--text);
  border: 1px solid var(--text);
  border-radius: 50%;
  font-size: 0;
  cursor: pointer;
}

.range__line {
  position: absolute;
  top: 16px;
  left: 8px;
  z-index: 0;
  overflow: hidden;
  width: calc(100% - 16px);
  height: 4px;
  border-radius: 4px;
  border: 1px solid var(--text);
}
.range__line span {
  display: block;
  height: 100%;
  width: 0%;
  background: var(--text);
  font-size: 0;
}

.filter-count {
  margin-left: 4px;
}

.filter-count::before {
  content: "(";
}

.filter-count::after {
  content: ")";
}

/**
 * List Collections Index
 */
.collection-item {
  --link: var(--text);
  --link-hover: var(--text);
  --bg: var(--COLOR-BG);
  display: flex;
  flex-wrap: wrap;
  position: relative;
  background: var(--bg);
  scroll-snap-align: start;
}

.collection-item--card {
  --bg: var(--COLOR-BG-ACCENT);
  --text: var(--COLOR-TEXT);
  background: var(--bg);
  color: var(--text);
}

.collection-item--card {
  --bg: var(--COLOR-BG-ACCENT);
  --text: var(--COLOR-TEXT);
  background: var(--bg);
  color: var(--text);
}

.collection-item__content {
  flex: 0 1 100%;
}

.collection-item__image {
  position: relative;
  overflow: hidden;
}

.collection-item__actions,
.collection-item__info {
  flex: 0 1 100%;
  padding: var(--inner);
  overflow: hidden;
}
@media only screen and (max-width: 749px) {
  .collection-item__actions,
.collection-item__info {
    padding: 12px;
  }
}

.collection-item--centered .collection-item__actions,
.collection-item--centered .collection-item__info {
  text-align: center;
}

@media (hover: hover) {
  .collection-item__bg .image-wrapper {
    --transform-scale: scale(1.08);
    transition: transform 2s cubic-bezier(0.215, 0.61, 0.355, 1);
  }

  .collection-item:hover .collection-item__bg .image-wrapper {
    transform: var(--transform-scale);
  }
}
.template-index .index-collections-list .grid__heading-holder {
  --inner: 44px;
}
@media only screen and (max-width: 749px) {
  .template-index .index-collections-list .grid__heading-holder {
    --inner: 32px;
  }
}
.template-index .index-collections-list .collection-list.grid {
  --grid-gap: 0;
  --grid-gap-vertical: 18px;
}
@media only screen and (max-width: 749px) {
  .template-index .index-collections-list .collection-list.grid {
    --grid-gap: 8px;
    --grid-gap-vertical: 18px;
  }
}
.template-index .index-collections-list .grid-outer {
  --grid-outer: 48px;
}
@media only screen and (max-width: 749px) {
  .template-index .index-collections-list .grid-outer {
    --grid-outer: 16px;
  }
}
.template-index .index-collections-list .collection-item__image {
  overflow: visible;
}
.template-index .index-collections-list .collection-item__info {
  display: flex;
  flex-direction: column;
  gap: 10px;
  padding: 20px 5px 0;
  align-items: center;
}
@media only screen and (max-width: 749px) {
  .template-index .index-collections-list .collection-item__info {
    padding: 16px 0 0 0;
  }
}
@media screen and (min-width: 1441px) {
  .template-index .index-collections-list .collection-item__info br {
    display: none;
  }
}
@media only screen and (max-width: 1399px) {
  .template-index .index-collections-list .collection-item__info br {
    display: none;
  }
}
.template-index .index-collections-list .collection-item__info-item-title {
  padding: 0;
}
.template-index .index-collections-list .collection-item__bg {
  padding: 0 12px;
}
@media only screen and (max-width: 749px) {
  .template-index .index-collections-list .collection-item__bg {
    width: 75%;
    padding: 0;
    margin: 0 auto;
  }
}

.collection-item__info span.collection-item__info-item-title,
.collection-item__info span:not(.collection-item__info-item-description) {
  --bg-size: 100% 1px;
  width: -moz-fit-content;
  width: fit-content;
  font-family: var(--FONT-MOHAVE);
  font-size: 24px;
  font-weight: 600;
  line-height: 120%;
  letter-spacing: 0;
  text-transform: uppercase;
  padding: 0 0 5px;
  background: linear-gradient(to right, currentcolor, currentcolor);
  background-size: 0% 1px;
  background-position: 50% 86%;
  background-repeat: no-repeat;
  transition: color 0.25s ease-in, background-size 0.25s ease-in;
}
@media only screen and (max-width: 749px) {
  .collection-item__info span.collection-item__info-item-title,
.collection-item__info span:not(.collection-item__info-item-description) {
    font-size: 20px;
    line-height: 28px;
  }
}
@media (hover: hover) {
  .collection-item__info span.collection-item__info-item-title:hover,
.collection-item__info span:not(.collection-item__info-item-description):hover {
