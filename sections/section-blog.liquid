<!-- /sections/section-blog.liquid -->
{%- liquid
	assign section_mode = section.settings.section_mode
  assign blog = blogs[section.settings.blog_name]
  assign blog_title = section.settings.title
  assign blog_description = section.settings.description
  assign color_scheme = 'color-' | append: section.settings.color_scheme
  assign animation_anchor = '#Blog--' | append: section.id
  assign animation_order = animation_order | plus: 1
	assign heading_font_family = section.settings.heading_font_family
	assign heading_font_size = section.settings.heading_font_size
	assign subtitle = section.settings.subtitle
	assign subheading_font_family = section.settings.subheading_font_family
	assign subheading_font_size = section.settings.subheading_font_size
	assign text_align_desktop = section.settings.text_align_desktop
	assign text_align_mobile = section.settings.text_align_mobile
	assign heading_position = section.settings.heading_position

	assign color_scheme = 'color-' | append: section.settings.color_scheme
  assign heading_tag = 'h2'
  assign articles_per_row = section.settings.grid
  assign columns_medium = 3

  if articles_per_row == 2 or articles_per_row == 4
    assign columns_medium = 2
  endif

  unless section.settings.heading_tag == 'automatic' or section.settings.heading_tag == blank
    assign heading_tag = section.settings.heading_tag
  endunless

	assign button_text = section.settings.button_text
	assign button_url = section.settings.button_url
	assign button_type = section.settings.button_type
	assign button_style = section.settings.button_style

-%}

{%- style -%}
  #Blog--{{ section.id }} {
    --PT: {{ section.settings.padding_top }}px;
    --PB: {{ section.settings.padding_bottom }}px;

    --COLUMNS: {{ articles_per_row }};
    --COLUMNS-MEDIUM: {{ columns_medium }};
  }

	@media only screen and (max-width: 749px) {
    #Blog--{{ section.id }} {
      --PT: {{ section.settings.padding_top_mobile }}px;
      --PB: {{ section.settings.padding_bottom_mobile }}px;
    }
	}
{%- endstyle -%}

<section
  id="Blog--{{ section.id }}"
  class="{{ section.settings.width }} blog-section section-padding {{ color_scheme }} {{ section_mode }}"
  data-section-id="{{ section.id }}"
  data-section-type="blog"
>
  <div class="blog">
    {% capture header_content %}
			<div class="section-blog__heading-wrapper {{ heading_position }}">
				{% if blog_title != blank %}
					<{{ heading_tag }} class="page__heading blog__title {{ heading_font_family }} {{ section.settings.heading_font_size }}"
					data-aos="hero"
					data-aos-anchor="{{ animation_anchor }}"
					data-aos-order="{{ animation_order }}"
					><a href="{{ blog.url | default: '#' }}">{{ blog_title }}</a></{{ heading_tag }}
					>
				{% endif %}

				{% if subtitle != blank %}
					<h3 class="blog__subtitle {{ subheading_font_family }} {{ subheading_font_size }} {{ text_align_desktop }} {{ text_align_mobile }}">
						{{ subtitle }}
					</h3>
				{% endif %}
			</div>

      {%- if blog_description != blank -%}
        {%- assign animation_order = animation_order | plus: 1 -%}

        <div class="blog__description {{ section.settings.text_font_size }}"
           data-aos="hero"
           data-aos-anchor="{{ animation_anchor }}"
           data-aos-order="{{ animation_order }}">{{ blog_description }}</div>
      {%- endif -%}
    {% endcapture %}

    {%- if header_content != blank -%}
      <div class="blog-section__header {{ section.settings.text_align_desktop }} {{ section.settings.text_align_mobile }}">
        {{ header_content }}
      </div>
    {%- endif -%}

    {%- render 'blog-posts', blog_articles: blog.articles, is_blog_page: false -%}

    {% if button_text %}
      <div
        class="section-blog__button section-blog__button--placeholder"
        data-aos="hero"
        data-aos-order="auto"
        data-aos-anchor="{{ section.id }}"
      >
        <a
          class="btn {{ button_style }} {{ button_type }}"
          href="{{ button_url }}"
        >
          <span>{{ button_text | escape }}</span>
        </a>
      </div>
    {% endif %}
  </div>
</section>

