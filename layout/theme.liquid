<!doctype html>
<html class="no-js no-touch supports-no-cookies" lang="{{ request.locale.iso_code }}">
  <head>
<!-- Start of Shoplift scripts -->
{% render 'shoplift' %}
<!-- End of Shoplift scripts -->

  <meta name="robots" content="index, follow">

    {%- render 'head' -%}

		{{ content_for_header }}

    {%- render 'luckyorange' -%}
    {%- render 'monk-app' -%}
  </head>

  <body
    id="{{ page_title | handle }}"
    class="template-{{ template.name | handle }} {% if template.suffix contains 'cafe' %}template-cafe-product{% endif %} {% if customer %} customer-logged-in{% endif %}{% if settings.animations_enable %} aos-initialized{% endif %}"
    data-animations="{{ settings.animations_enable }}"
  >
    {% comment %} {%- render 'loading' -%}
    {%- render 'redirect' -%} {% endcomment %}

    <a class="in-page-link visually-hidden skip-link" data-skip-content href="#MainContent">
      {{- 'general.accessibility.skip_to_content' | t -}}
    </a>

    <div class="container" data-site-container>
      <div class="header-sections">
        {% sections 'group-header' %}
      </div>

      {% sections 'group-overlay' %}

      <!-- CONTENT -->
      <main role="main" id="MainContent" class="main-content">
        {{ content_for_layout }}
      </main>
    </div>

    {% sections 'group-pre-footer' %}

    <footer class="footer-sections">
      {% sections 'group-footer' %}
    </footer>

    {%- if settings.enable_color_swatches -%}
      {% render 'template-swatch' %}
    {%- endif -%}

    {% render 'zoom-pswp' %}

    <button
      type="button"
      class="btn btn--scroll-top btn--black btn--solid"
      aria-label="{{ 'general.accessibility.scroll_to_top' | t }}"
      data-scroll-top-button
    >
      {%- render 'icon-arrow-up' -%}
    </button>

    <!-- Paste marketing code or third party scripts below this comment line ============== -->

    {%- render 'klaviyo' -%}
    {%- render 'karly-discount' -%}
    {%- render 'accessibility-code' -%}

    {% liquid
		assign upsell_popup = product.metafields.custom.upsell_popup.value
		assign upsell_popup_product = upsell_popup.upsell_product.value

		if upsell_popup_product.available and upsell_popup_product != blank and template.name == 'product'
			render 'product-upsell-popup', product: product
		endif
	%}
  </body>
</html>
