{{ 'section-hero-w-animation.css' | asset_url | stylesheet_tag }}

{%- liquid
	assign section_mode = section.settings.section_mode
	assign enable_sticky_position = section.settings.enable_sticky_position
	assign background = section.settings.background
  assign image_1 = section.settings.image_1
  assign banner_link = section.settings.link
  assign section_width = section.settings.width
  assign desktop_height = section.settings.height
  assign flex_align_desktop = section.settings.flex_align_desktop
  assign mobile_image = section.settings.mobile_image
  assign mobile_height = section.settings.mobile_height
  assign flex_align_mobile = section.settings.flex_align_mobile
  assign color_scheme = 'color-' | append: section.settings.color_scheme
  assign selected_color_scheme = section.settings.color_scheme | strip
  assign scheme_bg_color = settings.color_schemes[selected_color_scheme].settings.section_bg
  assign show_text_background = section.settings.show_text_background
  assign overlay_opacity = section.settings.overlay_opacity | times: 0.01
  assign show_overlay_text = section.settings.show_overlay_text
  assign padding_top = section.settings.padding_top | default: 0
  assign padding_bottom = section.settings.padding_bottom | default: 0
  assign padding_top_mobile = section.settings.padding_top_mobile | default: 0
  assign padding_bottom_mobile = section.settings.padding_bottom_mobile | default: 0

  # Rendering conditions
  assign render_image_1 = true
  assign render_image_overlay = false
  assign render_content_blocks = false
  unless show_overlay_text or overlay_opacity == 0.0
    assign render_image_overlay = true
  endunless
  if section.blocks.size > 0
    assign render_content_blocks = true
  endif

  capture sizes
    if section_width == 'wrapper--full'
      echo '100vw'
    else
      echo '(min-width: 990px) calc(100vw - 100px), (min-width: 750px) calc(100vw - 60px), calc(100vw - 32px)'
    endif
  endcapture

  capture sizes_mobile
    if section_width == 'wrapper--full'
      echo '100vw'
    else
      echo 'calc(100vw - 32px)'
    endif
  endcapture

  assign hero_transparent = true
  if show_text_background and scheme_bg_color.alpha != 0.0 or scheme_bg_color != blank
    assign hero_transparent = false
  endif

  assign show_header_backdrop = false
  if hero_transparent and show_overlay_text
    assign show_header_backdrop = true
  endif

  assign animation_order = 1
-%}

{%- style -%}
  {% if enable_sticky_position -%}
    @media (width >= 750px) {
      #shopify-section-{{ section.id }} {
        position: sticky;
        top: 0;
        z-index: 1;
        transition: all .1s linear;
      }
    }

    @media (width >= 1600px) {
      #shopify-section-{{ section.id }} .index-hero--with-animation {
        min-height: 48vw;
      }
    }
  {%- endif %}

  #{{ section.id }} {
    --PT: {{ padding_top }}px;
    --PB: {{ padding_bottom }}px;
    --PT-MOBILE: {{ padding_top_mobile }}px;
    --PB-MOBILE: {{ padding_bottom_mobile }}px;
    background: {{ background }};
  }

{% unless image_1 %}
    @media (width <= 749px) {
      #shopify-section-{{ section.id }} .index-hero--with-animation .hero__content__wrapper {
        position: relative;
      }
    }
{% endunless %}

{%- endstyle -%}

<div class="index-hero--with-animation">
  <div
    class="index-hero section-padding {{ color_scheme }} {{ section_mode }}"
    id="{{ section.id }}"
    data-section-id="{{ section.id }}"
    data-overlay-header
  >
    <div class="hero__wrapper frame {{ section_width }}">
      {%- if banner_link != blank -%}
        <a class="hero__images frame__item" href="{{ banner_link }}">
      {%- else -%}
        <div class="hero__images frame__item">
      {%- endif -%}

      {%- if image_1 or mobile_image -%}
        <div class="hero__split-image{% if image_1 == blank %} hero__split-image--blank{% endif %}">
          {%- render 'image-hero',
            image_desktop: image_1,
            image_mobile: mobile_image,
            sizes: sizes,
            desktop_height: desktop_height,
            mobile_height: mobile_height
          -%}
        </div>
      {%- endif -%}

      {%- if render_image_overlay -%}
        <div class="image-overlay" style="--overlay-opacity: {{ overlay_opacity }};"></div>
      {%- endif -%}

      {%- if banner_link != blank -%}
        </a>
      {%- else -%}
        </div>
      {%- endif -%}

      {%- if render_content_blocks -%}
        <div
          class="hero__content__wrapper {{ flex_align_desktop }} {{ flex_align_mobile }}{% if show_header_backdrop %} backdrop--linear{% endif %}"
          {% if show_header_backdrop %}
            style="--header-overlay-color: var(--overlay-bg); --header-overlay-opacity: {{ overlay_opacity }};"
          {% endif %}
        >
          <div
            class="hero__content{% if hero_transparent %} hero__content--transparent{% endif %}{% if show_overlay_text %} backdrop--radial{% endif %}"
            {% if overlay_opacity != 0.0 %}
              style="--overlay-opacity: {{ overlay_opacity }};"
            {% endif %}
          >
            {% comment %} Blocks for Image banner {% endcomment %}
            {% content_for 'blocks' %}
          </div>
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{%- if enable_sticky_position -%}
  <script>
    (function() {
      let ticking = false;
      const sectionElement = document.getElementById(`shopify-section-{{ section.id }}`);
      const sentinel = document.createElement('div');
      sentinel.style.cssText = 'height:1px;width:100%;visibility:hidden;position:relative;pointer-events:none;';
      sectionElement.parentNode.insertBefore(sentinel, sectionElement.nextSibling);

      function onScroll() {
        const sentinelRect = sentinel.getBoundingClientRect();
        sectionElement.style.opacity = sentinelRect.top <= 0 ? '0' : '1';
      }

      window.addEventListener('scroll', () => {
        if (window.theme.isMobile()) return;
        if (!ticking) {
          requestAnimationFrame(() => {
            onScroll();
            ticking = false;
          });
          ticking = true;
        }
      });
      onScroll();
    })();
  </script>
{%- endif -%}

{% schema %}
{
  "name": "Hero with animation",
  "class": "section-overlay-header",
  "blocks": [
    {"type": "heading"},
    {"type": "text"},
    {"type": "button-full-width"},
    {"type": "code"},
    {"type": "countdown-timer"},
    {"type": "group-buttons"},
		{"type": "image"},
		{"type": "decorative-element"}
  ],
  "settings": [
    {
      "type": "select",
      "id": "section_mode",
      "label": "Section mode",
