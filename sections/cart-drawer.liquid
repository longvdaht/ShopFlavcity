{%- liquid
  assign animation_name = 'cart-items-fade'
  assign animation_duration = 500
  assign animation_delay_initial = 200
  assign animation_delay_increment = 50
  assign block_index_pinned = 1
  assign block_index_static = 1
  assign cart_item_count = cart.item_count
  assign cart_title_default = 'cart.general.title' | t
  assign show_empty_cart_menu = settings.show_empty_cart_menu | default: null
  assign empty_cart_menu = settings.empty_cart_menu
  assign empty_cart_products = settings.empty_cart_products | default: null
  assign has_checkout_buttons = false

  assign threshold_gwp_blocks = section.blocks | where: 'type', 'gwp-threshold'
  assign cart_message_block = section.blocks | where: 'type', 'cart-message' | first
  assign title_block = section.blocks | where: 'type', 'title' | first
  assign free_shipping_block = section.blocks | where: 'type', 'free-shipping' | first
  assign gwp_message_block = section.blocks | where: 'type', 'gwp-message' | first
  assign products_block = section.blocks | where: 'type', 'products' | first

	assign promotion_block = section.blocks | where: 'type', 'promotion_block'
  assign product_block = section.blocks | where: 'type', 'products'
  assign checkout_buttons_block = section.blocks | where: 'type', 'checkout-buttons'
  assign color_scheme = 'color-' | append: section.settings.color_scheme

  for block in section.blocks
    case block.type
      when 'products'
        assign products_block_index = forloop.index

      when 'checkout-buttons'
        assign has_checkout_buttons = true
    endcase
  endfor

  if threshold_gwp_blocks.size > 0
    assign hasactive_threshold_gwp = false

    for block in threshold_gwp_blocks
      assign gwp_product = block.settings.gwp_product
      assign gwp_threshold = block.settings.threshold
      assign gwp_variant_id = block.settings.gwp_product_variant_id
      assign gwp_variant = gwp_product.variants | where: 'id', gwp_variant_id | first | default: gwp_product.variants[0]

      if gwp_variant.available
        assign hasactive_threshold_gwp = true
        break
      endif
    endfor
  endif
-%}

{%- style -%}
  #shopify-section-{{ section.id }} {
    z-index: 15;
  }
{%- endstyle -%}

<script src="{{ 'quantity-counter.js' | asset_url }}" defer="defer"></script>

{%- render 'cart-gwp-data' -%}

{%- capture cart_title -%}
  <span class="cart__title caps">
    {{ title_block.settings.title | default: cart_title_default }}

    <cart-count class="cart__items-count" data-cart-count="{{ cart_item_count }}">{{ cart_item_count }}</cart-count>
  </span>

  <button type="button" class="drawer__close" data-cart-drawer-close aria-label="{{ 'general.accessibility.close' | t }} {{ 'cart.general.title' | t }}">
    {%- render 'icon-cancel' -%}
  </button>
{%- endcapture -%}

{%- capture cart_items -%}
  {%- assign animation_delay = products_block_index | times: animation_delay_increment | plus: animation_delay_initial -%}

  <div class="cart-block" {{ block.shopify_attributes }}>
    <div class="cart__errors drawer__errors"
      data-cart-errors
      data-animation="{{ animation_name }}"
      data-animation-duration="{{ animation_duration }}"
      data-animation-delay="{{ animation_delay }}">
      <div class="cart__errors__inner">
        <span class="cart__errors__heading">{{ 'cart.general.limit_message' | t }}</span>

        <p class="cart__errors__content" data-error-message></p>

        <button class="cart__errors__close" type="button" data-cart-error-close aria-label="{{ 'general.accessibility.close' | t }} {{ 'cart.general.title' | t }}">
          {%- render 'icon-cancel' -%}
        </button>
      </div>
    </div>

    {%- comment -%}
      <div id="mr-div-embedded-cp-cvb-drawer"></div>
    {%- endcomment -%}

    <collapsible-elements single="true">
      <cart-items class="drawer__items" data-items-holder style="--base-animation-delay: {{ animation_delay }}ms">
        {%- render 'cart-line-items' -%}
      </cart-items>
    </collapsible-elements>
  </div>
{%- endcapture -%}

{%- capture checkout_buttons -%}
  {%- assign animation_delay = buttons_block_index | times: animation_delay_increment | plus: animation_delay_initial -%}
  <form id="cartForm" class="cart__form" action="{{ routes.cart_url }}" method="post" novalidate data-cart-form>

    <div class="cart__foot__inner">

      <div class="cart__price__holder" data-cart-price-holder>
        {%- render 'cart-price' -%}
      </div>

      <div class="cart__buttons-all">

        <div class="cart__buttons-wrapper">
          {%- if settings.enable_accept_terms -%}
            <input type="hidden" name="attributes[{{ 'cart.general.accepted_terms' | t }}]" value="Yes"/>
            <input type="checkbox" class="cart__acceptance__input" name="acceptance" id="acceptance" data-cart-acceptance-checkbox>
            <label for="acceptance" class="cart__acceptance__label" data-cart-acceptance-label>{{ settings.accept_terms_text }}</label>

            <p class="cart__terms cart__errors__content" data-terms-error-message></p>
          {%- endif -%}

          <div class="cart__buttons{% if settings.enable_accept_terms %} cart__buttons--disabled{% endif %}" data-cart-checkout-buttons>
            <fieldset class="cart__buttons__fieldset" data-cart-checkout-button>
              <button type="submit" name="checkout" class="btn btn--primary btn--full cart__checkout">
                {%- if settings.show_lock_icon -%}
                  {%- render 'checkout-secure' -%}
                  {{- 'cart.general.checkout_secure' | t -}}
                {%- else -%}
                  {{- 'cart.general.checkout' | t -}}
                {%- endif -%}
              </button>

              {%- if checkout_buttons_block[0].settings.enable_additional_buttons and additional_checkout_buttons -%}
                <div class="additional-checkout-buttons additional-checkout-buttons--vertical">
                  {{- content_for_additional_checkout_buttons -}}
                </div>
              {%- endif -%}
            </fieldset>
          </div>
        </div>

        {%- if checkout_buttons_block[0].settings.show_view_cart_button -%}
          {%- assign additional_checkout_buttons = checkout_buttons_block[0].settings.enable_additional_buttons -%}
          <a href="{{ routes.cart_url }}" class="cart__view btn btn--primary">{{- 'cart.general.view_cart' | t -}}</a>
        {%- endif -%}
      </div>

      <span class="cart__note">
        {{- 'cart.general.subtotal_note_alt' | t -}}
      </span>
    </div>
  </form>
{%- endcapture -%}

{%- capture progress_bar -%}
  {%- if gwp_message_block and hasactive_threshold_gwp -%}
    <div class="cart-block"
         data-animation="{{ animation_name }}"
         data-animation-duration="{{ animation_duration }}"
         data-animation-delay="{{ animation_delay }}"
            {{ gwp_message_block.shopify_attributes }}>
      {%- assign animation_delay = animation_delay | plus: animation_delay_initial -%}

      {%- if gwp_message_block.settings.message != blank -%}
        {%- render 'gwp-message'
          threshold_gwp_blocks: threshold_gwp_blocks,
          block: gwp_message_block,
          show_wheel: false,
          show_progress_bar: true,
          is_cart_drawer: true
        -%}
      {%- endif -%}
    </div>
    {%- elsif free_shipping_block -%}
    <div class="cart-block"
         data-animation="{{ animation_name }}"
         data-animation-duration="{{ animation_duration }}"
         data-animation-delay="{{ animation_delay }}"
            {{ free_shipping_block.shopify_attributes }}>
      {%- assign animation_delay = animation_delay | plus: animation_delay_initial -%}

      {%- if free_shipping_block.settings.message != blank -%}
        {%- render 'free-shipping'
          message: free_shipping_block.settings.message,
          logo: free_shipping_block.settings.free_shipping_logo,
          bg_color: free_shipping_block.settings.free_shipping_bg_color,
          text_color: free_shipping_block.settings.free_shipping_text_color,
          gradient: free_shipping_block.settings.free_shipping_gradient,
          show_wheel: false,
          show_progress_bar: true,
          is_cart_drawer: true
        -%}
      {%- endif -%}
    </div>
  {%- endif -%}
{%- endcapture -%}

{%- if template.name == 'cart' -%}
  <template id="cart-progress-bar-template">
    {{ progress_bar }}
  </template>
{%- endif -%}

{%- if template.name != 'cart' -%}
  <div
    data-section-id="{{ section.id }}"
    data-section-type="cart-drawer"
  >
    <cart-drawer
      class="drawer drawer--cart{% if cart_item_count == 0 %} is-empty{% endif %} {{ color_scheme }}"
      id="cart-drawer"
      tabindex="0"
    >
      <div class="drawer__inner" data-cart-drawer-inner data-scroll-lock-scrollable>
        <div class="drawer__body"
             data-cart-drawer-body data-scroll-lock-scrollable >

          {%- comment -%}
            {%- if cart.item_count == 0 -%}
            {%- liquid
              assign cart_custom_message_text = cart_message_block.settings.cart_custom_message_text
              assign custom_message_color = cart_message_block.settings.cart_custom_message_color
              assign cart_custom_message_background = cart_message_block.settings.cart_custom_message_background -%}

            {%- unless custom_message_color == 'rgba(0,0,0,0)' or custom_message_color == blank -%}
              {%- capture style -%}
                --text: {{ custom_message_color }};
                --bg: var(--bg-accent);
              {%- endcapture -%}
            {%- endunless -%}

            {%- unless cart_custom_message_background == 'rgba(0,0,0,0)' or cart_custom_message_background == blank -%}
              {%- capture style -%}
                {{ style }}
                --bg: {{ cart_custom_message_background }};
              {%- endcapture -%}
            {%- endunless -%}

            <div class="cart-block"
                 data-animation="{{ animation_name }}"
                 data-animation-duration="{{ animation_duration }}"
                 data-animation-delay="{{ animation_delay }}"
                    {{ cart_message_block.shopify_attributes }}
            >
              {%- assign animation_delay = animation_delay | plus: animation_delay_initial -%}

              {%- if cart_custom_message_text != blank -%}
                <div class="cart__message drawer__message drawer__message--custom" style="{{ style }}">
                  {{ cart_custom_message_text }}
                </div>
              {%- endif -%}
            </div>
          {%- endif -%}
          {%- endcomment -%}

          <div class="cart-block cart-block--top drawer__head "
               data-animation="{{ animation_name }}"
               data-animation-duration="{{ animation_duration }}"
               data-animation-delay="{{ animation_delay }}"
            {{ title_block.shopify_attributes }}>
            {%- assign animation_delay = animation_delay | plus: animation_delay_initial -%}

            {{ cart_title }}
          </div>

          {{ progress_bar }}

          <div class="cart-block"
               data-animation="{{ animation_name }}"
               data-animation-duration="{{ animation_duration }}"
               data-animation-delay="{{ animation_delay }}"
            {{ product_block[0].shopify_attributes }}>
            {%- assign animation_delay = animation_delay | plus: animation_delay_initial -%}

            {{ cart_items }}
          </div>

          <collapsible-elements data-drawer-body-collapsible-element="{{ section.id }}">
          {%- for block in section.blocks -%}
            {%- liquid
              assign pin_to_bottom = block.settings.pin_to_bottom

              if pin_to_bottom
                assign animation_delay = block_index_pinned | times: animation_delay_increment | plus: animation_delay_initial
                assign block_index_pinned = block_index_pinned | plus: 1
              else
                assign animation_delay = block_index_static | times: animation_delay_increment | plus: animation_delay_initial
                assign block_index_static = block_index_static | plus: 1
              endif

              capture cart_block_class
                echo 'cart-block'
              endcapture
            -%}

            {%- capture block_content -%}
              <div class="{{ cart_block_class }}"
                data-animation="{{ animation_name }}"
                data-animation-duration="{{ animation_duration }}"
                data-animation-delay="{{ animation_delay }}"
                {{ block.shopify_attributes }}
              >
                {%- case block.type -%}
                  {%- when 'cart-upsell' -%}
                      {%- render 'cart-block-upsell', block: block -%}
                  {%- when 'order-note' -%}
                      {%- render 'cart-block-order-note', block: block -%}
                  {%- when 'gift-note' -%}
                      {%- render 'cart-block-gift-note', block: block -%}
                  {%- when 'shipping-estimate' -%}
                      {%- render 'cart-block-shipping-calculator', block: block -%}
                  {%- when 'icon' -%}
                    {%- render 'icon' block: block -%}
                  {%- when 'payment-icons' -%}
                    {%- unless shop.enabled_payment_types == empty -%}
                      <ul class="cart__payment-icons{% if block.settings.icon_alignment == "center" %} justify-center{% endif %}">
                        {%- for type in shop.enabled_payment_types -%}
                          <li>{{ type | payment_type_svg_tag: class: 'payment-icon' }}</li>
                        {%- endfor -%}
                      </ul>
                    {%- endunless -%}
                  {%- when 'code' -%}
                    {%- if block.settings.code != blank -%}
                      <div class="cart__custom-code">
                        {{ block.settings.code }}
                      </div>
                   {%- endif -%}
                  {%- when 'checkout-buttons' -%}
                    {{ checkout_buttons }}
                {%- endcase -%}
              </div>
            {%- endcapture -%}

            {%- liquid
              if pin_to_bottom
                capture pinned_blocks
                  echo pinned_blocks
                  echo block_content
                endcapture
              else
                capture static_blocks
                  echo static_blocks
                  echo block_content
                endcapture
              endif
            -%}
          {%- endfor -%}

          {%- if static_blocks != blank -%}
            {{ static_blocks }}
          {%- endif -%}

          {%- if product_block.size == 0 -%}
            <div
              class="cart-block"
              data-animation="{{ animation_name }}"
              data-animation-duration="{{ animation_duration }}"
              data-animation-delay="{{ animation_delay }}"
            >
              {{ cart_items }}
            </div>
          {%- endif -%}

					{% if promotion_block != blank %}
						{%- assign promotion_product = promotion_block[0].settings.product -%}
						{%- assign promotion_product_exist = false -%}
						{%- for line_item in cart.items -%}
							{%- assign line_item_id = line_item.product.id -%}
							{% if line_item_id == promotion_product.id %}
								{%- assign promotion_product_exist = true -%}
							{% endif %}
						{%- endfor -%}
						<div
							class="cart-block"
							data-animation="{{ animation_name }}"
							data-animation-duration="{{ animation_duration }}"
							data-animation-delay="{{ animation_delay }}"
							data-cart-promotion-block
						>
							{% if promotion_product_exist == false %}
								{% render 'cart-promotion-block', promotion_block: promotion_block %}
							{% endif %}
						</div>
					{% endif %}
        </div>

        {%- if has_checkout_buttons == false or pinned_blocks != blank -%}
          <div
            class="drawer__foot"
            data-checkout-buttons
            style="--base-animation-delay: {{ block_index_static | times: animation_delay_increment }}ms;"
          >
            {%- if pinned_blocks != blank -%}
              {{ pinned_blocks }}
            {%- endif -%}

            {%- unless has_checkout_buttons -%}
              <div
                data-animation="{{ animation_name }}"
                data-animation-duration="{{ animation_duration }}"
                data-animation-delay="{{ block_index_pinned | times: animation_delay_increment | plus: animation_delay_initial }}"
              >
                {{ checkout_buttons }}
              </div>
            {%- endunless -%}
          </div>
        {%- endif -%}

        <div
          class="drawer__empty"
          data-cart-empty
          data-scroll-lock-scrollable
          style="--base-animation-delay: {{ animation_delay_initial }}ms"
        >
          <div class="drawer__empty__inner">
            <p class="drawer__empty__message">
              {{- 'cart.general.empty' | t -}}
            </p>

            {%- assign animation_delay = animation_delay_initial | plus: animation_delay_increment -%}
            {%- assign empty_state_subtitle = section.settings.empty_state_subtitle -%}
            {%- assign empty_state_button_title = section.settings.empty_state_button_title -%}
            {%- assign empty_state_button_url = section.settings.empty_state_button_url -%}

            {%- if empty_state_subtitle != blank -%}
              <div class="drawer__empty_subtitle">
                {{ empty_state_subtitle | newline_to_br }}
              </div>
            {%- endif -%}

            {%- for i in (1..3) -%}
              {%- assign banner_image_key = 'empty_state_banner_image_' | append: i -%}
              {%- assign banner_title_key = 'empty_state_banner_title_' | append: i -%}
              {%- assign banner_url_key = 'empty_state_banner_url_' | append: i -%}

              {%- assign banner_image = section.settings[banner_image_key] -%}
              {%- assign banner_title = section.settings[banner_title_key] -%}
              {%- assign banner_url = section.settings[banner_url_key] -%}

              {%- if banner_image != blank or banner_title != blank -%}
                <div class="drawer__empty__banner">
                  {%- if banner_image != blank -%}
                    <div class="drawer__empty__banner__image">
                      <div class="drawer__empty__banner__image_wrapper">
                        {{ banner_image | image_url: width: 250 | image_tag: alt: banner_image.alt }}
                      </div>
                    </div>
                  {%- endif -%}
                  {%- if banner_title != blank -%}
                    <div class="drawer__empty__banner__title">
                      {{ banner_title }}
                    </div>
                  {%- endif -%}
                  {%- if banner_url != blank -%}
                    <a href="{{ banner_url }}" class="drawer__empty__banner__url"></a>
                  {%- endif -%}
                </div>
              {%- endif -%}
            {%- endfor -%}

            {%- if empty_state_button_title != blank and empty_state_button_url != blank -%}
              <a href="{{ empty_state_button_url }}" class="drawer__empty__button btn btn--full btn--primary">
                {{ empty_state_button_title | strip_html | escape }}
              </a>
            {%- endif -%}

            {%- if show_empty_cart_menu and linklists[empty_cart_menu].links.size > 0 -%}
              <div class="drawer__empty__buttons">
                {%- for link in linklists[empty_cart_menu].links -%}
                  <div
                    class="drawer__empty__item"
                    data-animation="{{ animation_name }}"
                    data-animation-duration="{{ animation_duration }}"
                    data-animation-delay="{{ animation_delay }}"
                    {%- assign animation_delay = animation_delay | plus: animation_delay_increment -%}
                  >
                    <a href="{{ link.url }}" class="btn btn--full btn--primary">
                      {{ link.title | strip_html | escape }}
                    </a>
                  </div>
                {%- endfor -%}
              </div>
            {%- endif -%}

            {%- if empty_cart_products -%}
              <div
                class="drawer__empty__product"
                data-animation="{{ animation_name }}"
                data-animation-duration="{{ animation_duration }}"
                data-animation-delay="{{ animation_delay }}"
              >
                {%- liquid
                  assign animation_delay = animation_delay | plus: animation_delay_increment
                  if empty_cart_products != blank
                    for upsell_product in empty_cart_products
                      render 'upsell-product', upsell_product: upsell_product
                    endfor
                  endif
                -%}
              </div>
            {%- endif -%}

            {%- if settings.show_recently_viewed_products -%}
              <script src="{{ 'recently-viewed.js' | asset_url }}" defer="defer"></script>

              <recently-viewed
                class="drawer__empty__product hidden"
                id="recently-viewed-products-cart"
                data-limit="3"
                data-target="api-upsell-product"
                data-animation="{{ animation_name }}"
                data-animation-duration="{{ animation_duration }}"
                data-animation-delay="{{ animation_delay }}"
              ></recently-viewed>
            {%- endif -%}

						{% if promotion_block != blank %}
							{% render 'cart-promotion-block', promotion_block: promotion_block %}
						{% endif %}
          </div>
        </div>
      </div>

      <span class="underlay drawer__underlay" data-drawer-underlay></span>
    </cart-drawer>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Cart drawer",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "default": "scheme_1",
      "label": "Color scheme"
    },
    {
      "type": "header",
      "content": "Empty state"
    },
    {
      "type": "richtext",
      "id": "empty_state_subtitle",
      "label": "Subtitle"
    },
    {
      "type": "paragraph",
      "content": "Banners"
    },
    {
      "type": "paragraph",
      "content": "Banner 1"
    },
    {
      "type": "image_picker",
      "id": "empty_state_banner_image_1",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "empty_state_banner_title_1",
      "label": "Title"
    },
    {
      "type": "url",
      "id": "empty_state_banner_url_1",
      "label": "URL"
    },
    {
      "type": "paragraph",
      "content": "Banner 2"
    },
    {
      "type": "image_picker",
      "id": "empty_state_banner_image_2",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "empty_state_banner_title_2",
      "label": "Title"
    },
    {
      "type": "url",
      "id": "empty_state_banner_url_2",
      "label": "URL"
    },
    {
      "type": "paragraph",
      "content": "Banner 3"
    },
    {
      "type": "image_picker",
      "id": "empty_state_banner_image_3",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "empty_state_banner_title_3",
      "label": "Title"
    },
    {
      "type": "url",
      "id": "empty_state_banner_url_3",
      "label": "URL"
    },
    {
      "type": "paragraph",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "empty_state_button_title",
      "label": "Title"
    },
    {
      "type": "url",
      "id": "empty_state_button_url",
      "label": "URL"
    }
  ],
  "blocks": [
    {
      "type": "title",
      "name": "Title",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Text",
          "default": "Cart"
        }
      ]
    },
		{
			"type": "promotion_block",
			"name": "Promotion block",
				"limit": 1,
				"settings": [
					{
					"type": "text",
					"id": "title",
					"label": "Text",
					"default": "Cart"
					},
					{
						"type": "product",
						"id": "product",
						"label": "Product"
					},
					{
						"type": "image_picker",
						"id": "image",
						"label": "Product image"
					},
					{
						"type": "image_picker",
						"id": "promotion_image",
						"label": "Promotion image"
					},
					{
						"type": "color",
						"id": "bg_color",
						"label": "Background color",
						"default": "#FFDC5C"
					},
					{
						"type": "color",
						"id": "text_color",
						"label": "Text color",
						"default": "#005261"
					}
				]
			},
    {
      "type": "cart-message",
      "name": "Cart message",
      "limit": 1,
      "settings": [
        {
          "type": "richtext",
          "id": "cart_custom_message_text",
          "label": "Text",
          "default": "<p>Use coupon code <strong>WELCOME10</strong> for 10% off your first order.</p>"
        },
        {
          "type": "color",
          "id": "cart_custom_message_color",
          "label": "Text color"
        },
        {
          "type": "color",
          "id": "cart_custom_message_background",
          "label": "Background color"
        },
        {
          "type": "checkbox",
          "id": "pin_to_bottom",
          "label": "Pin to bottom",
          "default": false
        }
      ]
    },
    {
      "type": "free-shipping",
      "name": "Free shipping message",
      "limit": 1,
      "settings": [
        {
          "type": "paragraph",
          "content": "Set a minimum amount for free shipping in [Theme settings](/admin/themes/current/editor?context=theme)"
        },
        {
          "type": "textarea",
          "id": "message",
