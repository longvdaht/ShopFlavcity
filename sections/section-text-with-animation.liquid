{% liquid
	assign color_scheme = 'color-' | append: section.settings.color_scheme
	assign width = section.settings.width
	assign text_alignment = section.settings.text_alignment
	assign decorative_elements = section.blocks | where: 'type', 'decorative-element'
%}

{%- style -%}
	#TextWithAnimation--{{ section.id }} {
	--PT: {{ section.settings.padding_top }}px;
	--PB: {{ section.settings.padding_bottom }}px;
	}

	@media only screen and (max-width: 749px) {
	#TextWithAnimation--{{ section.id }} {
	--PT: {{ section.settings.padding_top_mobile }}px;
	--PB: {{ section.settings.padding_bottom_mobile }}px;
	}
	}
{%- endstyle -%}

{% if section.blocks.size > 0 %}
	<section
		id="TextWithAnimation--{{ section.id }}"
		class="text_with_animation section-padding {{ width }}"
	>
		{%- for block in decorative_elements -%}
			{%- render 'decorative-element', block: block -%}
		{%- endfor -%}

		<div class="text_with_animation__content {{ color_scheme }}">
			{% for block in section.blocks %}
				{% if block.type == 'heading' %}
					{% liquid
						assign text = block.settings.text
						assign heading_font_family = block.settings.heading_font_family
						assign heading_font_size = block.settings.heading_font_size
						assign color = block.settings.color
						assign padding_bottom = block.settings.padding_bottom
						assign padding_bottom_mobile = block.settings.padding_bottom_mobile

						capture block_style
							echo '--block-padding-bottom:' | append: padding_bottom | append: 'px;'
							echo '--block-padding-bottom-mobile:' | append: padding_bottom_mobile | default: padding_bottom | append: 'px;'
						endcapture
					%}
					{% if text != blank %}
						<h2
							style="--color-heading: {{ color }}; {{ block_style }}"
							class="hero__title {{ heading_font_size }} {{ heading_font_family }} {{ text_alignment }}"
							data-aos="hero"
							data-aos-order="auto"
							data-aos-anchor="{{ section.id }}"
							{{ block.shopify_attributes }}
						>
							{{ text }}
						</h2>
					{% endif %}

				{% elsif block.type == 'text' %}
					{% liquid
						assign text = block.settings.text
						assign text_font_family = block.settings.text_font_family
						assign text_font_size = block.settings.text_font_size
						assign color = block.settings.color
						assign padding_bottom = block.settings.padding_bottom
						assign padding_bottom_mobile = block.settings.padding_bottom_mobile

						capture block_style
							echo '--block-padding-bottom:' | append: padding_bottom | append: 'px;'
							echo '--block-padding-bottom-mobile:' | append: padding_bottom_mobile | default: padding_bottom | append: 'px;'
						endcapture
					%}
					{% if text != blank %}
						<div
							style="--color-text: {{ color }}; {{ block_style }}"
							class="hero__description {{ text_font_size }} {{ text_font_family }} {{ text_alignment }}"
							data-aos="hero"
							data-aos-order="auto"
							data-aos-anchor="{{ section.id }}"
							{{ block.shopify_attributes }}
						>
							{{ text }}
						</div>
					{% endif %}
				{% endif %}
			{% endfor %}
		</div>
	</section>
{% endif %}


{% schema %}
