<!-- /sections/section-accordion-group.liquid -->
{%- liquid
	assign section_mode = section.settings.section_mode
  assign enable_sticky_position = section.settings.enable_sticky_position

  if section_mode != 'flavcity-cafe'
    assign enable_sticky_position = false
  endif  

  assign columns = section.settings.columns
  assign animation_anchor = '#AccordionGroup--' | append: section.id
  assign animation_order = 0
  assign color_scheme = 'color-' | append: section.settings.color_scheme
-%}

{%- style -%}
  {% if enable_sticky_position -%}
    #shopify-section-{{ section.id }} {
      bottom: 0;
      position: relative;
      z-index: 1;
    }
  {%- endif %}

  #AccordionGroup--{{ section.id }} {
    --PT: {{ section.settings.padding_top }}px;
    --PB: {{ section.settings.padding_bottom }}px;

    --accordion-columns: {{ columns }};
  }

  @media only screen and (max-width: 749px) {
    #AccordionGroup--{{ section.id }} {
      --PT: {{ section.settings.padding_top_mobile }}px;
      --PB: {{ section.settings.padding_bottom_mobile }}px;
    }
  }
{%- endstyle -%}

{%- liquid
  if template.name == 'product' and product != empty and section.settings.show_blocks_from_metafield
    capture content_block
      echo content_block

      assign bloks_size = product.metafields.accentuate.question_item.size | minus: 1

      for i in (0..bloks_size)
        assign title = product.metafields.accentuate.question_item[i]
        assign content = product.metafields.accentuate.answer_item[i].html

        if forloop.first
          assign default_open = true
        else
          assign default_open = false
        endif

        assign animation_order = animation_order | plus: 1

        echo '<details class="accordion" data-collapsible '
        echo  'data-aos="hero"'
        echo  'data-aos-anchor="' | append: animation_anchor | append: '"'
        echo  'data-aos-order="' | append: animation_order | append: '">'

         echo '<summary class="accordion__title font-heading ' | append: section.settings.question_font_size | append: '" data-collapsible-trigger>'
          echo title

          render 'icon-plus'
          render 'icon-minus'
         echo '</summary>'

          echo '<div class="accordion__body rte"'
          if default_open != blank
            echo ' style="height: auto;"'
          endif
          echo ' data-collapsible-body>'
            echo '<div class="accordion__content" data-collapsible-content>'
              echo content
            echo '</div>'
          echo '</div>'
        echo '</details>'
      endfor
    endcapture
  endif
-%}

<div id="AccordionGroup--{{ section.id }}" class="accordion-group section-padding {{ color_scheme }} {{ section_mode }}">
  {%- if section.blocks.size > 0 or content_block != blank -%}
    <div class="faq faq-wrapper {{ section.settings.width }}"
      data-section-id="{{ section.id }}"
      data-section-type="faq"
    >
      <collapsible-elements single="true">
        <div class="accordion-group__items">
            {%- for block in section.blocks -%}
              {%- liquid
                assign title = block.settings.title
                assign content = block.settings.content
                assign default_open = block.settings.default_open
              -%}

              {%- if block.type == 'heading' and title != blank -%}
                {%- assign animation_order = animation_order | plus: 1 -%}

                <h3 class="accordion__heading {{ block.settings.heading_font_size }} {{ block.settings.align_text }} {{ block.settings.heading_font_family }}"
                  data-aos="hero"
                  data-aos-anchor="{{ animation_anchor }}"
                  data-aos-order="{{ animation_order }}"
                  {{ block.shopify_attributes }}
                >
                  {{ title }}
                </h3>
              {%- endif -%}

              {%- if block.type == 'question' and title != blank and content != blank -%}
                {%- if title != blank -%}
                  {%- assign animation_order = animation_order | plus: 1 -%}
                  <details class="accordion" data-collapsible
                    {% if default_open %}
                      open="true"
                    {% endif %}
                    data-aos="hero"
                    data-aos-anchor="{{ animation_anchor }}"
                    data-aos-order="{{ animation_order }}"
                    {{ block.shopify_attributes }}
                  >


                    <summary class="accordion__title font-heading {{ section.settings.question_font_size }}" data-collapsible-trigger>
                      {%- if block.settings.show_icon -%}
                        {%- liquid
                          assign icon_size = block.settings.icon_size
                          assign icon_color = block.settings.icon_color
                          assign icon_image = block.settings.icon_image
                          capture icon_style
                            echo 'style="'
                            echo '--icon-size: ' | append: icon_size | append: 'px;'
                            if icon_color != blank and icon_color.alpha != 0.0
                              echo ' --icons: ' | append: icon_color | append: ';'
                            endif
                            echo '"'
                          endcapture
                        -%}

                        <div class="icon__animated icon__animated--{{ block.id }}{% if icon_image != blank %} icon__animated--image{% endif %}" {{ icon_style }}>
                          {%- liquid
                            if icon_image
                              assign icon_width = icon_size
                              assign icon_width_retina = icon_width | times: 2
                              assign icon_sizes = icon_width | append: 'px'
                              assign icon_widths = icon_width | append: ', ' | append: icon_width_retina

                              render 'image' image: icon_image, width: icon_width_retina, sizes: icon_sizes, widths: icon_widths
                            else
                              render 'animated-icon', filename: block.settings.icon_name
                            endif
                          -%}
                        </div>
                      {%- endif -%}

                      {{ title }}

                      {%- render 'icon-plus' -%}
                      {%- render 'icon-minus' -%}
                    </summary>

                    <div class="accordion__body rte"{% if default_open != blank %} style="height: auto;"{% endif %} data-collapsible-body>
                      <div class="accordion__content" data-collapsible-content>
                        {{ content }}
                      </div>
                    </div>
                  </details>
                {%- endif -%}
              {%- endif -%}
            {%- endfor -%}

          {%- if content_block != blank -%}
            {{ content_block }}
          {%- endif -%}
        </div>
      </collapsible-elements>
    </div>
  {%- endif -%}
</div>

{%- if enable_sticky_position -%}
  <script>
    const accordionSection = document.getElementById(`shopify-section-{{ section.id }}`);
    const accordionSentinel = document.createElement('div');

    accordionSentinel.style.height = '1px';
    accordionSentinel.style.width = '100%';
    accordionSentinel.style.visibility = 'hidden';
    accordionSentinel.style.position = 'relative';

    accordionSection.insertAdjacentElement('beforebegin', accordionSentinel);

    const reviewsSliderObserver = new IntersectionObserver((entries) => {
      const entry = entries[0];

      if (entry.isIntersecting) {
        accordionSection.style.position = 'sticky';
      } else {
        accordionSection.style.position = 'relative';
      }
    }, {
      threshold: [0],
      rootMargin: "300px"
    });
    reviewsSliderObserver.observe(accordionSentinel);
  </script>
{%- endif -%}

