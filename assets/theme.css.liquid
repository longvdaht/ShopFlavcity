/* ================ Custom Pagination ================ */
.pagination-custom {
  display: flex;
  justify-content: center;
  margin: 0 auto;
  padding: max(var(--inner), var(--outer)) 0;
  width: 100%;
  font-size: var(--font-body-small);
  overflow: hidden;
}
