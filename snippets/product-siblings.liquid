<!-- /snippets/product-siblings.liquid -->

{%- liquid
	assign product_api = product_api | default: false

	assign legacy_sibling_color = block.settings.sibling_color | default: product.metafields.theme.sibling_color.value | default: product.metafields.theme.sibling_colour.value | default: product.metafields.theme.siblings_color.value | default: product.metafields.theme.siblings_colour.value | default: product.metafields.theme.siblings_colors.value | default: product.metafields.theme.siblings_colours.value
	assign sibling_color = legacy_metafield_color | default: product.title
	assign hide_labels_class = ''
	assign sibling_type = block.settings.sibling_type
-%}

{%- for entry in settings.siblings -%}
	{%- assign sibling_products = entry.product_list.value -%}
	{%- assign has_siblings = sibling_products | has: 'id', product.id -%}

	{%- if has_siblings and sibling_products != blank -%}
		<div
			class="product__block product__siblings{{ hide_labels_class }} block-padding"
			{{ block_style }}
			{% if animation_name %}
				data-animation="{{ animation_name }}"
				data-animation-duration="{{ animation_duration }}"
				data-animation-delay="{{ animation_delay }}"
			{% endif %}
			{{ block.shopify_attributes }}
		>
			{% comment %} Form ID must match value in product-form.liquid {% endcomment %}
			{%- comment -%}
				<input
					type="hidden"
					form="{{ product_form_id }}"
					name="properties[{{ 'general.siblings.property_name' | t }}]"
					value="{{ sibling_color | remove: 'Protein Smoothie' | remove: 'Protein smoothie' | remove: 'protein smoothie' }}"
				>
			{%- endcomment -%}

			<fieldset>
				<div class="radio__fieldset radio__fieldset--swatches">
					<legend class="radio__legend">
            <span class="radio__legend__label">
              <span class="radio__legend__option-name">
								{% if template.suffix contains 'cafe' %}
									{{ 'general.siblings_cafe.label' | t }}
								{% else %}
									{{ 'general.siblings.label' | t }}
								{% endif %}
							</span>

							{%- capture label -%}
								{%- if sibling_color != blank -%}
									<small class="radio__legend__value {%- unless settings.show_labels %} hidden {%- endunless -%}">{{ sibling_color | remove: 'Protein Smoothie' | remove: 'Protein smoothie' | remove: 'protein smoothie' }}</small>
								{%- endif -%}
							{%- endcapture -%}

							{%- if current_variant.metafields.theme.color_description != blank -%}
								{%- assign form_style = settings.form_style -%}

								{%- capture color_description -%}
									<small class="radio__legend__value radio__legend__color__description">{{ current_variant.metafields.theme.color_description }}</small>
								{%- endcapture -%}
							{%- endif -%}

							{%- if form_style == 'classic' -%}
                <div class="radio__legend__values">
              {%- endif -%}
									{{ label -}}
									{{ color_description }}
							{%- if form_style == 'classic' -%}
                </div>
              {%- endif -%}
            </span>
					</legend>

					{% if sibling_type == 'select' %}
						{% liquid
							capture swatch_image
								if settings.sibling_style == 'image'
									case settings.swatch_size
										when 'regular'
											assign sibling_width = 2.2 | times: settings.base_font_size | times: 2 | round
										when 'large'
											assign sibling_width = 3 | times: settings.base_font_size | times: 2 | round
									endcase

									assign sibling_sizes = sibling_width | append: 'px'
									assign sibling_width_15x = sibling_width | times: 1.5
									assign sibling_width_2x = sibling_width | times: 2
									assign sibling_widths = sibling_width | append: ', ' | append: sibling_width_15x | append: ', ' | append: sibling_width_2x
									assign image = product.metafields.custom.sibling_picker_image.value | default: product.featured_media.preview_image

									render 'image', image: image, width: sibling_width_2x, height: sibling_width_2x, widths: sibling_widths, sizes: sibling_sizes, aspect_ratio: 1, show_backfill: false
								endif
							endcapture
						%}

						<popout-select class="select-popout" {{ template.suffix }}>
							<button type="button"
											class="select-popout__toggle"
											aria-expanded="false"
											aria-controls="{{ unique }}-select-quantity"
											aria-labelledby="{{ unique }}-select-quantity-label"
											data-popout-toggle>
								<div class="select-popout__button-wrapper">
									<div class="sibling__image-wrapper">
										{{ swatch_image }}
									</div>
									<span data-popout-toggle-text>{{ sibling_color | remove: 'Protein Smoothie' | remove: 'Protein smoothie' | remove: 'protein smoothie' }}</span>
								</div>
								{% render 'icons' with 'caret-down' %}
							</button>

							<ul id="{{ unique }}-select-quantity" class="select-popout__list" data-popout-list data-scroll-lock-scrollable>
								{%- for sib_product in sibling_products limit: 50 -%}
									{% liquid
										capture swatch_image
											if settings.sibling_style == 'image'
												case settings.swatch_size
													when 'regular'
														assign sibling_width = 2.2 | times: settings.base_font_size | times: 2 | round
													when 'large'
														assign sibling_width = 3 | times: settings.base_font_size | times: 2 | round
												endcase

												assign sibling_sizes = sibling_width | append: 'px'
												assign sibling_width_15x = sibling_width | times: 1.5
												assign sibling_width_2x = sibling_width | times: 2
												assign sibling_widths = sibling_width | append: ', ' | append: sibling_width_15x | append: ', ' | append: sibling_width_2x
												assign image = sib_product.metafields.custom.sibling_picker_image.value | default: sib_product.featured_media.preview_image

												render 'image', image: image, width: sibling_width_2x, height: sibling_width_2x, widths: sibling_widths, sizes: sibling_sizes, aspect_ratio: 1, show_backfill: false
											endif
										endcapture
									%}

									<li class="select-popout__item{% if sib_product.id == product.id %} is-active{% endif %}">
										<a
											href="{{ sib_product.url }}"
											class="select-popout__option"
											data-swap-url="{{ sib_product.url }}"
											data-swap-target="{{ section.id }}--{{ sib_product.handle }}"
											{% if sib_product.id == product.id %}aria-current="true"{% endif %}
											data-swap-id="{{ sib_product.id }}"
										>
											<div class="sibling__image-wrapper">
												{{ swatch_image }}
											</div>

											<span>
												{{ sib_product.title | remove: 'Protein Smoothie' | remove: 'Protein smoothie' | remove: 'protein smoothie' }}
											</span>
										</a>
									</li>
								{%- endfor -%}
							</ul>
						</popout-select>
					{% else %}
						<fieldset>
							<div class="radio__fieldset radio__fieldset--swatches">
								<div class="radio__buttons">
									{%- for sib_product in sibling_products limit: 50 -%}
										{%- liquid
											assign modifier_class = ''
											assign sib_product_title_handleize = sib_product.title | handleize
											assign is_current_product = sib_product | has: 'id', product.id

											if sib_product.handle == product.handle
												assign modifier_class = ' sibling__link--current'
											endif

											if sib_product.available == false
												assign modifier_class = modifier_class | append: ' sibling__link--sold-out'
											endif

											assign sibling_color_name = ''
											for color_props in color_props_list
												assign product_list = color_props.product_list.value
												assign found_in_list = product_list | where: 'id', sib_product.id | first

												if found_in_list != null
													assign sibling_color_name = color_props.name
													break
												endif
											endfor

											assign legacy_metafield_color = sib_product.metafields.theme.sibling_color.value | default: sib_product.metafields.theme.sibling_colour.value | default: sib_product.metafields.theme.siblings_color.value | default: sib_product.metafields.theme.siblings_colour.value | default: sib_product.metafields.theme.siblings_colors.value | default: sib_product.metafields.theme.siblings_colours.value
											assign sib_color = sibling_color_name | default: legacy_metafield_color | default: sib_product.title
											assign swatch_color = sib_color | handle

											capture swatch_image
												if settings.sibling_style == 'image'
													case settings.swatch_size
														when 'regular'
															assign sibling_width = 2.2 | times: settings.base_font_size | times: 2 | round
														when 'large'
															assign sibling_width = 3 | times: settings.base_font_size | times: 2 | round
													endcase

													assign sibling_sizes = sibling_width | append: 'px'
													assign sibling_width_15x = sibling_width | times: 1.5
													assign sibling_width_2x = sibling_width | times: 2
													assign sibling_widths = sibling_width | append: ', ' | append: sibling_width_15x | append: ', ' | append: sibling_width_2x
													assign image = sib_product.metafields.custom.sibling_picker_image.value | default: sib_product.featured_media.preview_image

													render 'image', image: image, width: sibling_width_2x, height: sibling_width_2x, widths: sibling_widths, sizes: sibling_sizes, aspect_ratio: 1, show_backfill: false
												endif
											endcapture
										-%}

										{%- capture swatch -%}
											{%- if swatch_color != blank -%}
												var(--{{ swatch_color }})
											{%- else -%}
												var(--swatch-default)
											{%- endif -%}
										{%- endcapture -%}

										{% if template.suffix contains 'cafe' %}
											<div
												class="swatches swatch__button swatch__button--{{ settings.swatch_style }} swatch-{{ swatch_color | handle }}"
												style="--swatch: {{ swatch }};"
												{% if is_current_product %}aria-current="true"{% endif %}
											>
												<a
													href="{{ sib_product.url }}"
													class="sibling__link{{ modifier_class }} test"
												>
													<div class="sibling__image-wrapper">
														{{ swatch_image }}
													</div>

													<span>{{ sib_product.metafields.bundle.title | default: sib_product.title | strip_html }}</span>
													<span class="visually-hidden">{{ swatch_color }}</span>
												</a>
											</div>
										{% else %}
											<tooltip-component
												class="swatches swatch__button swatch__button--{{ settings.swatch_style }} swatch-{{ swatch_color | handle }}"
												style="--swatch: {{ swatch }};"
												{% if is_current_product %}aria-current="true"{% endif %}
											>
												<a
													href="{{ sib_product.url }}"
													class="sibling__link{{ modifier_class }} test"
													data-swap-url="{{ sib_product.url }}"
													data-swap-target="{{ section.id }}--{{ sib_product.handle }}"
													data-swap-id="{{ sib_product.id }}"
												>
													<div class="sibling__image-wrapper">
														{{ swatch_image }}
													</div>

													<span>{{ sib_product.metafields.bundle.title | default: sib_product.title | strip_html }}</span>
													<span class="visually-hidden">{{ swatch_color }}</span>
												</a>
											</tooltip-component>
										{% endif %}
									{%- endfor -%}
								</div>
							</div>
						</fieldset>
					{% endif %}
				</div>
			</fieldset>
		</div>
	{%- endif -%}
{%- endfor -%}