{%- liquid
  assign badge_blocks = section.blocks | where: 'type', 'badge'
  assign nav_image_blocks = section.blocks | where: 'type', 'nav_image'
  assign link_style_blocks = section.blocks | where: 'type', 'link_style'
  assign sub_image_blocks = section.blocks | where: 'type', 'sub_nav_image'
  assign animation_name = 'drawer-items-fade'
  assign animation_duration = 500
  assign animation_delay_min = 50
  assign animation_delay_additional = 200
  assign highlight_item = highlight_item | downcase | strip_html | escape
  assign link_title_lowercase = link.title | downcase | strip_html | escape
  assign expands = false
  assign block_count = 0
  assign link_level = link_level | default: 0
  assign link_level_next = link_level | plus: 1
  assign forloop_index = forloop_index | default: 1

  if section
    assign index = index | append: ""
    for block in section.blocks
      if block.settings.position == index
        assign block_count = block_count | plus: 1
      endif
    endfor
  endif

  if link.levels > 0 or block_count > 0
    assign expands = true
    assign key = link.url | append: link.title | append: link.levels | append: unique | append: block.type | append: index | md5
  endif

  if secondary_menu
    assign expands = false
  endif
-%}

{%- capture link_markup -%}
  {%- if link.url == "#" -%}
    <span class="sliderow__title{% if secondary_menu %} sliderow__title--secondary{% endif %}{% if highlight_item == link_title_lowercase %} sliderow__title--highlight{% endif %}" data-sliderule-close="sliderule-{{ key }}">{{ link.title | strip_html | escape }}</span>
  {%- else -%}
    <a class="sliderow__title sliderow__title-without__childlink{% if secondary_menu %} sliderow__title--secondary{% endif %}{% if highlight_item == link_title_lowercase %} sliderow__title--highlight{% endif %}" href="{{ link.url }}">
			{%- assign link_title_handleize = link.title | handleize -%}

			{%- for block in sub_image_blocks -%}
				{%- assign title_handleize = block.settings.title | handleize -%}
				{%- if link_title_handleize == title_handleize -%}
					{% liquid
						assign image = block.settings.image
						assign aspect_ratio = 1 | divided_by: block.settings.aspect_ratio
						assign sizes = '(min-width: 990px) calc(100vw / ' | append: columns | append: '), (min-width: 380px) 350px, calc(100vw - 30px)'
						assign image_background = block.settings.image_background
						assign border_radius = block.settings.border_radius
						assign border_color = block.settings.border_color
					%}

          {%- if badge_blocks.size > 0 -%}
            {%- assign badge_capture = '' -%}

            {%- for badge_block in badge_blocks -%}
              {%- assign badge_block_title_handleize = badge_block.settings.title | handleize -%}
              {%- assign badge_block_layout = badge_block.settings.badge_layout -%}
              {%- assign show_badge = false -%}

              {%- if badge_block_layout == 'image' or badge_block_layout == 'both' -%}
                {%- assign show_badge = true -%}
              {%- endif -%}

              {% capture badge_capture %}
                {%- if badge_block_title_handleize == link_title_handleize and badge_block.settings.text != blank and show_badge -%}
                  <span class="badge" style="--background-color: {{ badge_block.settings.badge_bg_color }}; --text-color: {{ badge_block.settings.badge_text_color }};">
                    {{- badge_block.settings.text -}}
                  </span>
                  {% break %}
                {%- endif -%}
              {% endcapture %}
            {%- endfor -%}
          {%- endif -%}

					<div class="header__mobile__image-wrapper"
							 style="--border-radius: {{ border_radius }}px;--border-color: {{ border_color }};--image-background: {{ image_background }};"
					>
            {%- if badge_capture != blank -%}
              <div class="badge__nav">
                {{ badge_capture }}
              </div>
            {%- endif -%}
						{%- render 'image',
							image: image,
							aspect_ratio: aspect_ratio,
							sizes: sizes,
							loading: 'lazy',
							fetchpriority: 'high'
						-%}
					</div>
				{%- endif -%}
			{%- endfor -%}

			{% if link_title_handleize == 'account' %}
				{% render 'icons' with 'account' %}
			{% endif %}


			{%- assign link_title_handleize = link.title | handleize -%}
			<span class="sliderow__title-span sliderow__title-span__{{ link_level }} {% if link_title_handleize contains 'shop-all' %}sliderow__title-span-all{% endif %}">
        {{ link.title | strip_html | escape }}

        {%- if expands or link_level > 0 -%}
          {%- render 'superscript', link_collection: link -%}
        {%- endif -%}

        {%- if badge_blocks.size > 0 -%}
          {%- assign badge_capture = '' -%}

          {% capture badge_capture %}
            {%- for badge_block in badge_blocks -%}
              {%- assign badge_block_title_handleize = badge_block.settings.title | handleize -%}
              {%- assign badge_block_layout = badge_block.settings.badge_layout -%}
              {%- assign show_badge = false -%}

              {%- if badge_block_layout == 'text' or badge_block_layout == 'both' -%}
                {%- assign show_badge = true -%}
              {%- endif -%}

              {%- if badge_block_title_handleize == link_title_handleize and badge_block.settings.text != blank and show_badge -%}
                <span class="badge" style="--text-color-sub:{{ badge_block.settings.badge_text_color_sub_nav }};">
                  {{- badge_block.settings.text -}}
                </span>
              {%- endif -%}
            {%- endfor -%}
          {% endcapture %}

          {%- if badge_capture != blank -%}
            <div class="badge__nav--inline">
              {{ badge_capture }}
            </div>
          {%- endif -%}
        {%- endif -%}
      </span>
    </a>
  {%- endif -%}
{%- endcapture -%}

<div class="sliderule__wrapper{% if secondary_menu %} sliderule__wrapper--secondary{% endif %} sliderule__wrapper__{{ link_level }}">
  {%- if expands and block.type != 'menu-columns' -%}
    <mobile-sliderule id="sliderule-{{ key }}">
			{% assign forloop_index_string = forloop_index | append: '' %}

			{%- for block in nav_image_blocks -%}
				{%- assign block_index = block.settings.position -%}
				{% if block_index == forloop_index_string %}
					{% liquid
						assign image = block.settings.image
						assign sizes = '(min-width: 380px) 350px, calc(100vw - 30px)'
						assign aspect_ratio = block.settings.aspect_ratio | default: 1.5
						assign background = block.settings.background | default: '#ffffff'
						assign border_radius = block.settings.border_radius | default: 8
					%}
				{% endif %}
			{%- endfor -%}

      <button class="sliderow {{ link.title | handleize }}" type="button"
        data-animates="{{ link_level }}"
        data-animation="{{ animation_name }}"
        data-animation-delay="{{ animation_delay | plus: animation_delay_additional }}"
        data-animation-duration="{{ animation_duration }}"
        data-sliderule-open="sliderule-{{ key }}"
				style="--background-color: {{ background }}; --border-radius: {{ border_radius }}px;"
			>

				{%- assign link_title_handleize = link.title | handleize -%}

				{% if image != blank %}
					<div class="sliderow__image-wrapper">
						{%- render 'image',
							image: image,
							aspect_ratio: aspect_ratio,
							sizes: sizes,
							loading: 'lazy',
							fetchpriority: 'high'
						-%}
					</div>
				{% endif %}

        <span class="sliderow__title{% if secondary_menu %} sliderow__title--secondary{% endif %}{% if highlight_item == link_title_lowercase %} sliderow__title--highlight{% endif %}">
					{%- for block in nav_image_blocks -%}
						{%- assign title_handleize = block.settings.title | handleize -%}
						{%- if link_title_handleize == title_handleize -%}
							{% liquid
								assign image = block.settings.image
								assign aspect_ratio = 1
								assign sizes = '(min-width: 990px) calc(100vw / ' | append: columns | append: '), (min-width: 380px) 350px, calc(100vw - 30px)'
							%}
							<div class="header__mobile__image-wrapper">
							{%- render 'image',
								image: image,
								aspect_ratio: aspect_ratio,
								sizes: sizes,
								loading: 'lazy',
								fetchpriority: 'high'
							-%}
						</div>
						{%- endif -%}
					{%- endfor -%}

          {%- if link_style_blocks.size > 0 -%}
            {%- assign link_with_style = '' -%}
            {%- assign link_style = '' -%}

            {%- for link_style_block in link_style_blocks -%}
              {%- assign badge_block_title_handleize = link_style_block.settings.title | strip_html | escape | handleize -%}

              {%- if badge_block_title_handleize == link_title_handleize -%}
                {% capture link_with_style %}
                  {{ link_style_block.settings.title }}
                {% endcapture %}

                {%- if link_style_block.settings.link_color != 'rgba(0,0,0,0)' and  link_style_block.settings.link_color != '' -%}
                  {% capture link_style -%}
                    --link: {{ link_style_block.settings.link_color }};
                  {%- endcapture %}
                {%- endif -%}

                {% break %}
              {%- endif -%}
            {%- endfor -%}
          {%- endif -%}

					<div class="sliderow__title-wrapper">
						<span class="sliderow__title-span sliderow__title-span__{{ link_level }}" {%- if link_style != blank %} style="{{ link_style }}"{%- endif -%}>
							 {%- if link_with_style != blank -%}
                 {{ link_with_style }}
               {%- else -%}
                 {{ link.title | strip_html | escape }}
               {%- endif -%}

              {%- if link_level > 0 -%}
                {%- render 'superscript', link_collection: link -%}
              {%- endif -%}
						</span>

            {%- if badge_blocks.size > 0 -%}
              {%- assign badge_capture = '' -%}
              {%- assign link_title_handleize = link.title | handleize -%}

              {%- for badge_block in badge_blocks -%}
                {%- assign badge_block_title_handleize = badge_block.settings.title | handleize -%}
                {%- assign show_badge = false -%}

                {%- if badge_block_layout == 'text' or badge_block_layout == 'both' -%}
                  {%- assign show_badge = true -%}
                {%- endif -%}

                {% capture badge_capture %}
                  {%- if badge_block_title_handleize == link_title_handleize and badge_block.settings.text != blank and show_badge -%}
                    <span class="badge" style="--background-color: {{ badge_block.settings.badge_bg_color }}; --text-color: {{ badge_block.settings.badge_text_color }};">
                     {{- badge_block.settings.text -}}
                    </span>
                    {% break %}
                  {%- endif -%}
                {% endcapture %}
              {%- endfor -%}
            {%- endif -%}

            {%- if badge_capture != blank -%}
              <div class="badge__nav--relative">
                {{ badge_capture }}
              </div>
            {%- endif -%}

						<span class="sliderule__chevron sliderule__chevron--right">
							{% render 'icons' with 'icon-arrow-circle' %}
							<span class="visually-hidden">{{ 'general.accessibility.show_menu' | t }}</span>
						</span>
					</div>
        </span>
      </button>

      <div class="mobile__menu__dropdown sliderule__panel"
        data-sliderule="{{ link_level_next }}"
        data-scroll-lock-scrollable>
        <div class="sliderow sliderow--back"
          data-animates="{{ link_level_next }}"
          data-animation="{{ animation_name }}"
          data-animation-delay="150"
          data-animation-duration="{{ animation_duration }}">
          <button class="sliderow__back-button" type="button" data-sliderule-close="sliderule-{{ key }}">
            <span class="sliderule__chevron sliderule__chevron--left">
							{% render 'icons' with 'icon-back-arrow-circle' %}
              <span class="visually-hidden">{{ 'general.accessibility.exit_menu' | t }}</span>
            </span>
          </button>
        </div>
        <div class="sliderow__links" data-links>
          {%- for link in link.links -%}
            {%- assign index_recursive = index | append: 'x' | append: forloop.index -%}
            {%- assign animation_delay = 50 | times: forloop.index -%}

            {%- render 'nav-item-mobile', link: link, index: index_recursive, forloop_index: forloop.index, link_level: link_level_next, highlight_item: highlight_item, animation_delay: animation_delay, unique: unique -%}
          {%- endfor -%}

          {% comment %} Render block content {% endcomment %}
          {%- if section and section.blocks.size > 0 -%}
            {%- assign header_blocks = '' -%}
            {%- assign animation_delay_next = 50 -%}

            {%- unless link.links.size > 0 -%}
              {%- assign animation_delay = animation_delay | divided_by: forloop_index | at_least: animation_delay_min | minus: animation_delay_next -%}
            {%- endunless -%}

            {%- assign animation_delay = animation_delay | plus: animation_delay_additional -%}

            {%- for block in section.blocks -%}
              {%- if block.settings.position == index and block.type == 'image' -%}
                {%- assign animation_delay = animation_delay | plus: animation_delay_next -%}

                {%- capture header_blocks -%}
                  {{ header_blocks }}

                  {% render 'header-block', block: block, link_level_next: link_level_next, animation_delay: animation_delay, is_mobile: true %}
                {%- endcapture -%}
              {%- endif -%}
            {%- endfor -%}

            {%- if header_blocks != '' -%}
              <div class="sliderule-grid blocks-{{ block_count }}">
                {{ header_blocks }}
              </div>
            {%- endif -%}
          {%- endif -%}
        </div>
      </div>
    </mobile-sliderule>
  {%- else -%}
    {% comment %} Single menu item, no nesting {% endcomment %}
    <div class="sliderow"
      role="button"
      data-animates="{{ link_level }}"
      data-animation="{{ animation_name }}"
      data-animation-delay="{{ animation_delay | plus: animation_delay_additional }}"
      data-animation-duration="{{ animation_duration }}">
      {{ link_markup }}
    </div>
  {%- endif -%}
</div>