{%- assign onboarding_product = onboarding_product | default: false -%}

<div
  class="product__block product__head"
  {{ block_style }}
  {% if animation_name %}
    data-animation="{{ animation_name }}"
    data-animation-duration="{{ animation_duration }}"
    data-animation-delay="{{ animation_delay }}"
  {% endif %}
>
  {%- capture subheading_option_content -%}
    {%- case block.settings.subheading_option -%}
      {%- when 'type' -%}
        {% capture tag_type_content %}
          {%- for tag in product.tags -%}
            {%- if tag contains '_type' -%}
              {{- tag | replace: '_type:' -}}
              {%- break -%}
            {%- endif -%}
          {%- endfor -%}
        {% endcapture %}
        {%- if tag_type_content != blank -%}
          <span class="product-item__type heading-mini">
           {{ tag_type_content }}
          </span>
        {%- endif -%}
      {%- when 'vendor' -%}
        {%- if product.vendor -%}
          <nav class="breadcrumbs breadcrumbs--no-padding product__breadcrumbs">
            <a href="{{ product.vendor | url_for_vendor }}">{{ product.vendor }}</a>
          </nav>
        {%- endif -%}
      {%- when 'collection' -%}
        {%- if collection or product.collections.size > 0 -%}
          {%- assign current_collection = collection | default: product.collections[0] -%}

          <nav class="breadcrumbs breadcrumbs--no-padding product__breadcrumbs">
            <a href="{{ current_collection.url }}">Back to {{ current_collection.title }}</a>
          </nav>
        {%- endif -%}
      {%- when 'breadcrumb' -%}
        {% render 'breadcrumbs', breadcrumbs_modifier: 'breadcrumbs--no-padding product__breadcrumbs' %}
    {%- endcase -%}
  {% endcapture %}

  {%- if subheading_option_content != blank -%}
    <div class="block-padding">
      {{ subheading_option_content }}
    </div>
  {%- endif -%}

  <div class="product__title__wrapper block-padding" {{ block.shopify_attributes }}>
		{%- assign product_card_text = product.metafields.custom.product_card_text -%}

		{% if product_card_text != blank and template.suffix contains 'cafe' %}
			<p class="product-title__additional-text">{{ product_card_text.value }}</p>
		{% endif %}

    <h1 class="product__title {{ block.settings.heading_font_size | default: 'heading-small' }}">
      {%- if onboarding_product -%}
        <span data-zoom-caption>{{ 'home_page.onboarding.product_title' | t }}</span>
      {%- else -%}
        {%- unless is_title_linked -%}
          {%- if product.title contains 'Protein Smoothie: Single-Serve Packets' -%}
            <span data-zoom-caption>Protein Smoothie 10-Packet</span>
          {%- else -%}
            <span data-zoom-caption>{{ product.title | strip_html }}</span>
          {%- endif -%}
        {%- else -%}
          <a href="{{ product.url }}">
            <span data-zoom-caption>{{ product.title | strip_html }}</span>
          </a>
        {%- endunless -%}
      {%- endif -%}
    </h1>
  </div>
</div>
