{%- liquid
	# background and bg images
	assign bg_image = section.settings.image_bg_desktop
	assign bg_image_secondary = section.settings.image_bg_desktop_secondary
	assign bg_image_mobile = section.settings.image_bg_mobile
	assign enable_parallax = section.settings.enable_parallax
	assign background_color = section.settings.background_color

	# width and height
	assign desktop_height = section.settings.height
	assign mobile_height = section.settings.mobile_height
	assign width = section.settings.width

	# appearance
	assign color_scheme = 'color-' | append: section.settings.color_scheme

	# animations
	assign animation_anchor = '#BrickSection--' | append: section.id
	assign animation_order = 0

	# media + badge
	assign video = section.settings.video
	assign image = section.settings.image
	assign image_badge = section.settings.image_badge
	assign image_shape = section.settings.image_shape

	# image width
	assign image_width = section.settings.image_width
	capture sizes
		if image
			if image_width == 'three-quarters'
				echo '(min-width: 750px) 75vw, 100vw'
			else
				echo '(min-width: 750px) 50vw, 100vw'
			endif
		endif
	endcapture

	assign figure_width_class = ''
	if image_width == 'three-quarters'
		assign figure_width_class = ' brick__block--three-quarters'
	endif

	# alignment
	capture alignment
		if section.settings.text_alignment == 'text-left'
			echo ' align--middle-left'
		else
			echo ' align--middle-center'
		endif
	endcapture

	# section blocks
	assign decorative_elements = section.blocks | where: 'type', 'decorative-element'
	assign blocks_markup = ''
-%}

{{ 'section-image-with-text-bg.css' | asset_url | stylesheet_tag }}

{%- style -%}
	#BrickSection--{{ section.id }} {
	--PT: {{ section.settings.padding_top }}px;
	--PB: {{ section.settings.padding_bottom }}px;
	}

	@media only screen and (max-width: 749px) {
	#BrickSection--{{ section.id }} {
	--PT: {{ section.settings.padding_top_mobile }}px;
	--PB: {{ section.settings.padding_bottom_mobile }}px;
	}
	}
{%- endstyle -%}

{% capture style %}
	--background-color: {{ background_color }};
{% endcapture %}

{%- capture section_media -%}
	{%- if video != blank -%}
		<script src="{{ 'video-background.js' | asset_url }}" defer="defer"></script>

		<div class="brick__block__image">
			<div
				class="video-background"
				style="--aspect-ratio: 1;"
			>
				<video-background
					class="video__player is-loading column__image--{{ image_shape }}"
					data-video-player
					data-video-id="{{ section.id }}-video-background"
				>
					<template data-video-template>
						{{ video | video_tag: autoplay: true, image_size: '1085x', loop: true, muted: true, controls: false }}
					</template>
				</video-background>
			</div>
		</div>
	{%- elsif image != blank -%}
		<div class="brick__block__image">
			{% if image_badge != blank %}
				<div class="brick__block__image-badge">
					{%- render 'image',
						image: image_badge,
						aspect_ratio: 1,
						sizes: sizes,
						loading: 'lazy',
						fetchpriority: 'high'
					-%}
				</div>
			{% endif %}

			{%- render 'image-hero', image: image, sizes: sizes, desktop_height: desktop_height, mobile_height: mobile_height, image_shape: image_shape -%}
		</div>
	{%- else -%}
		<div class="brick__block__image">
			{%- render 'image-hero' sizes: sizes, desktop_height: desktop_height, mobile_height: mobile_height, image_shape: image_shape -%}
		</div>
	{%- endif -%}
{%- endcapture -%}

{% capture decorative_elements_capture %}
	{%- for block in decorative_elements -%}
		{%- render 'decorative-element' block: block -%}
	{%- endfor -%}
{% endcapture %}

<section
	id="BrickSection--{{ section.id }}"
	data-section-id="{{ section.id }}"
	data-section-type="double"
	class="image-with-text-bg section-padding {{ section.settings.text_alignment }} {{ color_scheme }} {{ section.settings.custom_selector }}"
	style="{{ style }}"
>
	{% if bg_image != blank %}
		<div class="iwt-bg__image">
			{% if bg_image_mobile != blank %}
				<div class="iwt-bg__image-mobile"
						 aria-hidden="true"
					{% if enable_parallax %}
						data-simple-parallax-element
						data-parallax-delay="0.2"
						data-parallax-scale="1.1"
						data-parallax-overflow="true"
					{% endif %}
				>
					{%- render 'image', image: bg_image_mobile, alt: bg_image_mobile.alt -%}
				</div>
			{% endif %}

			<div class="iwt-bg__image-desktop"
					 aria-hidden="true"
				{% if enable_parallax %}
					data-simple-parallax-element
					data-parallax-delay="0.6"
					data-parallax-scale="1.3"
					data-parallax-overflow="true"
					data-parallax-max-transition="99"
				{% endif %}
			>
				{%- render 'image', image: bg_image, alt: bg_image.alt -%}
			</div>

			{% if bg_image_secondary != blank %}
				<div class="iwt-bg__image-secondary"
						 aria-hidden="true"
					{% if enable_parallax %}
						data-simple-parallax-element
						data-parallax-delay="0.4"
						data-parallax-scale="1.1"
						data-parallax-overflow="true"
					{% endif %}
				>
					{%- render 'image', image: bg_image_secondary, alt: bg_image_secondary.alt -%}
				</div>
			{% endif %}
		</div>
	{% endif %}

	{%- if section.blocks.size > 0 -%}
	{%- for block in section.blocks -%}
	{%- liquid
		assign block_content = ''
		capture block_style
			echo '--block-padding-bottom:' | append: block.settings.padding_bottom | append: 'px;'
		endcapture
	-%}

	{%- capture block_content -%}
	{%- case block.type -%}
	{%- when 'heading' -%}
	{%- if block.settings.title != blank -%}
	{%- liquid
		assign animation_order = animation_order | plus: 1
		assign heading_tag = 'h2'
		assign heading_font_family = block.settings.heading_font_family
		assign heading_color = block.settings.color

		unless block.settings.heading_tag == 'automatic' or block.settings.heading_tag == blank
			assign heading_tag = block.settings.heading_tag
		endunless
	-%}

	<{{ heading_tag }}
	class="hero__title {{ block.settings.heading_font_size }} block-padding {{ heading_font_family }}"
	data-aos="hero"
	data-aos-anchor="{{ animation_anchor }}"
	data-aos-order="{{ animation_order }}"
	style="{{ block_style }} --color-heading: {{ heading_color }};"
	{{ block.shopify_attributes }}
	>
	{{ block.settings.title }}
</{{ heading_tag }}>
	{%- endif -%}

	{%- when 'subheading' -%}
		{%- if block.settings.subheading != blank -%}
			{%- assign animation_order = animation_order | plus: 1 -%}
			<p
				class="hero__subheading {{ block.settings.text_font_size }} block-padding"
				data-aos="hero"
				data-aos-anchor="{{ animation_anchor }}"
				data-aos-order="{{ animation_order }}"
				style="{{ block_style }}"
				{{ block.shopify_attributes }}
			>
				{{ block.settings.subheading }}
			</p>
		{%- endif -%}

	{%- when 'text' -%}
		{%- if block.settings.text != blank -%}
			{%- assign animation_order = animation_order | plus: 1 -%}
			<div
				class="hero__rte {{ block.settings.text_font_size }} block-padding"
				data-aos="hero"
				data-aos-anchor="{{ animation_anchor }}"
				data-aos-order="{{ animation_order }}"
				style="{{ block_style }}"
				{{ block.shopify_attributes }}
			>
				{{ block.settings.text }}
			</div>
		{%- endif -%}

	{%- when 'buttons' -%}
		{%- if block.settings.button_text != blank -%}
			{%- liquid
				assign prev_index = forloop.index0 | minus: 1
				assign next_index = forloop.index0 | plus: 1
				assign prev_block = section.blocks[prev_index]
				assign next_block = section.blocks[next_index]
				assign animation_order = animation_order | plus: 1
				assign first_button_of_group = false
				assign last_button_of_group = false
				if next_block.type == 'buttons' and forloop.index0 == 0 or prev_block.type != 'buttons' and next_index != section.blocks.size and next_block.type == 'buttons'
					assign first_button_of_group = true
				endif

				if prev_block.type == 'buttons' and next_block.type != 'buttons' and prev_index != -1 or forloop.index == section.blocks.size and prev_block.type == 'buttons'
					assign last_button_of_group = true
				endif

				assign button_style = block.settings.button_style
				if button_style == 'btn--text' and block.settings.show_arrow
					assign button_style = button_style | append: ' btn--text-no-underline'
				endif
			-%}

			{%- if first_button_of_group -%}
				<div class="hero__button-group">
			{%- endif -%}

			<div
				class="hero__button block-padding"
				data-aos="hero"
				data-aos-anchor="{{ animation_anchor }}"
				data-aos-order="{{ animation_order }}"
				style="{{ block_style }}"
				{{ block.shopify_attributes }}
			>
				<a
					href="{{ block.settings.button_url | default: '#!' }}"
					class="btn {{ button_style }} {{ block.settings.button_size }} {{ block.settings.button_type }}"
				>
					<span>{{ block.settings.button_text }}</span>

					{%- if block.settings.show_arrow -%}
						{%- render 'icon-arrow-right' -%}
					{%- endif -%}
				</a>
			</div>

			{%- if last_button_of_group -%}
				</div>
			{%- endif -%}
		{%- endif -%}

	{%- endcase -%}
	{%- endcapture -%}

{%- capture blocks_markup -%}
	{{ blocks_markup }}

	{{ block_content }}
{%- endcapture -%}
	{%- endfor -%}

	<div class="brick__section {% if section.settings.layout == 'is-reversed' %} brick__section--reversed{% endif %} {{ width }} {{ desktop_height }} {{ mobile_height }}">
		{%- if section_media != blank -%}
			<div class="brick__block {{ figure_width_class }} brick__block--images">
				{{ section_media }}
			</div>
		{%- endif -%}

		<div class="brick__block brick__block--text"
			{{ block.shopify_attributes }}
		>
			<div class="brick__block__text">
				{%- if blocks_markup != '' -%}
					<div class="hero__content hero__content--compact hero__content--no-padding">
						{{ blocks_markup }}
					</div>
				{%- endif -%}
			</div>
		</div>

		{% if decorative_elements_capture != blank %}
			{{ decorative_elements_capture }}
		{% endif %}
	</div>
{%- else -%}
	{%- render 'no-blocks' -%}
{%- endif -%}
</section>


{% schema %}
