}
.popup-promo .close {
  position: absolute;
  top: 10px;
  right: 10px;
  width: 20px;
  height: 20px;
  display: flex;
  flex-flow: row wrap;
  justify-content: center;
  align-items: center;
  padding: 0;
  color: inherit;
  transition: transform 0.3s;
}
.popup-promo .close:hover {
  transform: rotate(90deg);
}
@media only screen and (max-width: 479px) {
