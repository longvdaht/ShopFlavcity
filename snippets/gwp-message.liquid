{% comment %}
  Renders GWP message

  Accepts:
  - block: {Object} GWP block (required)
  - show_wheel: {Boolean} Show progress wheel
  - show_progress_bar: {Boolean} Show progress bar
  - is_cart_drawer: {Boolean} Is cart drawer

  Usage:
{%- render 'gwp-message'
  threshold_gwp_blocks: threshold_gwp_blocks,
  block: gwp_message_block,
  show_wheel: false,
  show_progress_bar: true,
  is_cart_drawer: true
-%}
{% endcomment %}

{%- liquid
  assign message = block.settings.message
  assign final_message = block.settings.final_message
  assign logo = block.settings.logo
  assign bg_color = block.settings.bg_color
  assign text_color = block.settings.text_color
  assign gradient = block.settings.gradient
  assign show_message = false
  if message != blank
    assign show_message = true
  endif

  assign thresholds = blank

  for block in threshold_gwp_blocks
    assign gwp_product = block.settings.gwp_product
    assign gwp_threshold = block.settings.threshold
    assign gwp_variant_id = block.settings.gwp_product_variant_id
    assign gwp_variant = gwp_product.variants | where: 'id', gwp_variant_id | first | default: gwp_product.variants[0]

    if gwp_variant.available
      assign thresholds = thresholds | append: '|||' | append: gwp_threshold
    endif
  endfor

  assign thresholds = thresholds | remove_first: '|||' | split: '|||' | sort
-%}

{%- capture style -%}
  {% if gradient != blank -%}
    --FREE-SHIPPING-GRADIENT: {{ gradient }};
  {% endif -%}
  {% if text_color != blank -%}
    --FREE-SHIPPING-TEXT-COLOR: {{ text_color }};
  {% endif -%}
  {% if bg_color != blank -%}
    --FREE-SHIPPING-BG-COLOR: {{ bg_color }};
  {% endif -%}
{%- endcapture -%}

{%- if show_message -%}
  {%- liquid
    assign subtotal_without_currency = cart.total_price | plus: 0 | divided_by: 100

    for threshold in thresholds
      assign threshold_num = threshold | plus: 0
      if threshold_num > subtotal_without_currency
        assign limit = threshold_num
        break
      endif
    endfor

    assign total_limit = thresholds | last | plus: 0
    assign total_limit_currency = total_limit | times: 100
    assign limit_currency = limit | times: 100
    assign percent = total_limit | minus: subtotal_without_currency | times: 100 | divided_by: total_limit
    assign percent = 100 | minus: percent

    if settings.currency_code_enable
      assign limit_currency = limit_currency | minus: cart.total_price | money_with_currency
    else
      assign limit_currency = limit_currency | minus: cart.total_price | money_without_trailing_zeros
    endif

    capture left_to_spend
      echo '<span data-left-to-spend>' | append: limit_currency | append: '</span>'
    endcapture

    assign message = message | replace: '||amount||', left_to_spend
    assign gwp_final_message = final_message

    capture gwp_message_classes
      if is_cart_drawer
        echo 'drawer__message '
      endif

      if template.name == 'cart'
        echo 'cart__message '
      endif

      echo 'free-shipping'

      if subtotal_without_currency >= total_limit and gwp_final_message != blank
        echo ' is-success'
      endif
    endcapture
  -%}

  <div class="{{ gwp_message_classes }}"
    data-gwp-message="{% if gwp_final_message != blank %}true{% else %}false{% endif %}"
    data-gwp-message-limit="{{ thresholds | last | plus: 0 }}"
    data-gwp-message-limits="{{ thresholds | join: '|||' }}"
    {% if style != blank %}
      style="{{ style }}"
    {% endif %}
  >
    {%- if show_wheel -%}
      <div class="free-shipping__graph" data-progress-graph style="--stroke-dashoffset: 87.96459430051421;">
        <svg height="18" width="18" viewBox="0 0 18 18">
          <circle r="7" cx="9" cy="9" />
          <circle class="free-shipping__graph-progress" stroke-dasharray="87.96459430051421 87.96459430051421" r="7" cx="9" cy="9" />
        </svg>
      </div>
    {%- endif -%}

    {%- if gwp_final_message != blank -%}
      <span class="free-shipping__success-message">{{ gwp_final_message }}</span>
    {%- endif -%}

    <span class="free-shipping__default-message">
      {{ message }}
      {% if logo %}
        <span class="logo">
          <img src="{{ logo | image_url: width: 17 }}"
               alt="{{ logo.alt }}"
               style="width: 17px; margin-bottom: -2px">
        </span>
      {% endif %}
    </span>

    {%- if show_progress_bar -%}
      <div class="free-shipping__progress-bar-wrapper">
        <progress class="free-shipping__progress-bar" data-progress-bar value="{{ percent }}" max="100"></progress>
        {%- assign last_threshold = thresholds | last | plus: 0 -%}
        {%- for threshold in thresholds -%}
          {%- unless forloop.last -%}
            {%- assign threshold_num = threshold | plus: 0 -%}
            {%- assign threshold_position = threshold_num | times: 100 | divided_by: last_threshold -%}
            <span class="free-shipping__progress-bar-threshold" style="--POSITION-X: {{ threshold_position }}%"></span>
          {%- endunless -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

    <div class="confetti">
      <span class="confetti__dot confetti__dot--1"></span>
      <span class="confetti__dot confetti__dot--2"></span>
      <span class="confetti__dot confetti__dot--3"></span>
      <span class="confetti__dot confetti__dot--4"></span>
      <span class="confetti__dot confetti__dot--5"></span>
      <span class="confetti__dot confetti__dot--6"></span>
    </div>
  </div>
{%- endif -%}
