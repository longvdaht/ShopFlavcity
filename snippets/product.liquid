{%- liquid
  assign animation_anchor = '#Products--' | append: section.id
  assign animation_order = animation_order | plus: 1
  assign animation_name = 'hero'

  assign badge_block = section.blocks | where: 'type', 'badges'
  assign navigation_block = section.blocks | where: 'type', 'navigation'
  assign current_variant = product.selected_or_first_available_variant
  assign featured_product = featured_product | default: false
  assign onboarding_product = false
  assign product_sticky_enable = section.settings.product_sticky_enable
  assign variant_image_scroll = section.settings.variant_image_scroll
  assign enable_video_looping = section.settings.enable_video_looping
  assign image_size = section.settings.image_size
  assign image_layout = section.settings.image_layout
  assign mobile_image_style = 'thumbs'
  assign featured_media = current_variant.featured_media | default: product.featured_media
  assign featured_media_aspect_ratio = featured_media.aspect_ratio | default: 1
  assign is_title_linked = true

  if template.name == 'product'
    assign is_title_linked = false
  endif

  if product.empty?
    assign onboarding_product = true
  endif

  if featured_product
    assign product_sticky_enable = false
    assign variant_image_scroll = false
  endif

  assign show_thumbnails = false
  assign enable_thumbs = false
  assign enable_thumbs_mobile = false

  if image_layout == 'thumbnails' or image_layout == 'thumbnails-left' or image_layout == 'thumbnails-right' or image_layout == 'thumbnails-bottom'
    assign enable_thumbs = true
    assign show_thumbnails = true
  endif

  if mobile_image_style == 'thumbs'
    assign show_thumbnails = true
    assign enable_thumbs_mobile = true
  endif

  assign modifier = image_layout | default: 'thumbnails'
  assign product_wrapper_modifier = 'product__wrapper--' | append: modifier

  assign wrapper_tag = 'div'
  if product_sticky_enable
    assign wrapper_tag = 'product-sticky'
  endif

  assign show_buy_buttons = false
  assign buy_buttons = section.blocks | where: 'type', 'buttons'

  if buy_buttons.size > 0
    assign show_buy_buttons = true
  endif

  assign image_width = 770

  if image_size == 'small'
    assign product_wrapper_modifier = product_wrapper_modifier | append: ' product__wrapper--small'
    assign image_width = 525
  endif

  if image_size == 'stretch'
    assign product_wrapper_modifier = product_wrapper_modifier | append: ' product__wrapper--stretch'
    assign image_width = 970
  endif

  if section.settings.reverse_layout
    assign product_wrapper_modifier = product_wrapper_modifier | append: ' product__wrapper--reversed'
  endif

  assign product_form_id = 'ProductForm--' | append: section.id | append: '-' | append: product.id
  assign show_cart_bar = section.settings.show_cart_bar
  assign unique = section.id

  assign sibling_color = product.metafields.theme.sibling_color.value | default: product.metafields.theme.sibling_colour.value | default: product.metafields.theme.siblings_color.value | default: product.metafields.theme.siblings_colour.value | default: product.metafields.theme.siblings_colors.value | default: product.metafields.theme.siblings_colours.value


  capture product_images_classlist
    echo 'product__images'

    if enable_thumbs
      echo ' product__images--thumbs'
    else
      echo ' product__images--no-thumbs'
    endif

    if enable_thumbs_mobile
      echo ' product__images--mobile-slider'
    else
      echo ' product__images--mobile-slider'
    endif
  endcapture

  assign sold_out = false
  assign on_sale = false
  assign badge_soldout = ''

  if product.metafields.theme.badge != blank and product.metafields.theme.badge.type == 'single_line_text_field'
    assign badge_metafields = product.metafields.theme.badge.value
  endif

  if product.compare_at_price > product.price and block.settings.sale_badge
    assign on_sale = true
  endif

  assign preorder = false
  if product.metafields.theme.preorder.type == 'boolean' and product.metafields.theme.preorder.value == true
    assign preorder = true
  endif

  unless product.available
    assign sold_out = true
  endunless

  assign product_tags = product.tags | join: ','
  if product_tags contains '_preorder'
    assign preorder = true
  endif

  if block.settings.show_automatic_new_badge
    assign product_created_timestamp = product.created_at | date: '%s' | plus: 0
    assign days_in_seconds = block.settings.badge_new_date_limit | times: 24 | times: 60 | times: 60
    assign current_date_timestamp = "now" | date: '%s'
    assign check_date_timestamp = current_date_timestamp | minus: days_in_seconds

    if product_created_timestamp > check_date_timestamp
      assign badge_new = 'products.product.new' | t
    endif
  endif

  if block.settings.sold_out_badge and sold_out
    assign badge_soldout = 'products.product.sold_out' | t
  endif

  assign color_scheme = 'color-' | append: section.settings.color_scheme

  if navigation_block.size > 0 and navigation_block[0].settings.subheading_option != 'none'
    assign padding_bottom = navigation_block[0].settings.padding_bottom
    assign padding_bottom_mobile = navigation_block[0].settings.padding_bottom_mobile

    capture block_style
      if padding_bottom
        echo '--block-padding-bottom: ' | append: padding_bottom | append: 'px;'
        echo '--block-padding-bottom-mobile: ' | append: padding_bottom_mobile | default: padding_bottom | append: 'px;'
      endif
    endcapture


    if block_style != blank
      assign block_style = 'style="' | append: block_style | append: '"'
    endif

    capture navigation_content
      echo '<div class="product__block block-padding"' | append: block.shopify_attributes | append: block_style | append:'>'
        render 'navigation', block: navigation_block[0]
      echo '</div>'
    endcapture
  endif
-%}

{%- if badge_block.size > 0 and badge_block[0].settings.product_badges -%}
  {% capture badge_tag_capture %}
    {%- for product_tag in product.tags -%}
      {% if product_tag contains '_badge:' %}
        {%- assign product_tag_value = product_tag | split: '_badge:' | last -%}
        {%- assign product_tag_handleize = product_tag | handleize -%}

        {%- for i in (1..5) -%}
          {%- assign badge_background_color = '' -%}
          {%- assign badge_text_color = '' -%}

          {%- assign text_key = 'badge_label_' | append: i -%}
          {%- assign text_color_key = 'badge_text_color_' | append: i -%}
          {%- assign bg_color_key = 'badge_bg_color_' | append: i -%}

          {%- assign badge_label = settings[text_key] -%}
          {%- assign badge_label_handleize = badge_label | handleize -%}

          {%- if product_tag_handleize contains badge_label_handleize and badge_label_handleize != blank -%}
            {%- assign badge_text_color = settings[text_color_key] -%}
            {%- assign badge_background_color = settings[bg_color_key] -%}

            {% if badge_text_color != blank and badge_text_color != 'rgba(0,0,0,0)' %}
              {%- assign badge_text_color = badge_text_color -%}
            {%- endif -%}

            {% if badge_background_color != blank and badge_background_color != 'rgba(0,0,0,0)' %}
              {%- assign badge_background_color = badge_background_color -%}
            {%- endif -%}

            {% break %}
          {%- endif -%}
        {%- endfor -%}

        {% capture badges_product_tag %}
          {{- badges_product_tag -}}

          {%- if product_tag_value != blank -%}
            <span class="badge"
                  style="
                  {%- if badge_background_color != blank -%}
                    --background-color: {{ badge_background_color }};
                  {%- endif -%}
                    {%- if badge_text_color != blank -%}
                    --text-color: {{ badge_text_color }};
                  {%- endif -%}">
              {{ product_tag_value }}
            </span>
          {%- endif -%}
        {% endcapture %}
      {%- endif -%}
    {%- endfor -%}
  {% endcapture %}

  {% capture badges_content %}
    {%- if badges_product_tag != blank -%}
      {{ badges_product_tag }}
    {%- endif -%}

    {%- if badge_tag_capture != blank and block.settings.product_badges -%}
      {{ badge_tag_capture }}
    {%- elsif badge_metafields != '' and badge_metafields != null and block.settings.product_badges or badge_new != '' and badge_new != null and block.settings.product_badges or badge_soldout != '' and badge_soldout != null and block.settings.product_badges -%}
      <span class="badge-box badge">
        {%- if badge_soldout != '' and badge_soldout != null -%}
          {{ badge_soldout }}
				{%- elsif badge_new != '' and badge_new != null -%}
          {{ badge_new }}
        {%- elsif badge_metafields != '' and badge_metafields != null -%}
          {{ badge_metafields }}
        {%- endif -%}
      </span>
    {%- elsif preorder and sold_out == false and block.settings.product_badges -%}
      <span class="preorder-box badge">{{ 'products.product.pre_order' | t }}</span>
    {%- elsif on_sale and sold_out == false -%}
      <span class="sale-box badge">{{ 'products.product.on_sale' | t }}</span>
    {%- endif -%}
  {% endcapture %}
{%- endif -%}

<product-component
  id="Product--{{ unique }}"
  class="index-product section-padding {{ color_scheme }}"
  data-section-id="{{ unique }}"
  data-section-type="product"
  data-product-handle="{{ product.handle }}"
  data-url="{{ product.url }}"
  data-enable-history-state="true"
  data-overlay-header
  data-sticky-enabled="{{ product_sticky_enable }}"
  data-variant-image-scroll="{{ variant_image_scroll }}"
  {% if show_cart_bar %}
    data-cart-bar-enabled
  {% endif %}
	data-test="{{ show_cart_bar }}"
>

  {%- style -%}
    {%- if show_cart_bar -%}
      :root { --cart-bar-height: 80px; }
    {%- endif -%}

    #Product--{{ section.id }} {
      --PT: {{ section.settings.padding_top }}px;
      --PB: {{ section.settings.padding_bottom }}px;

      --swatch-size: var(--swatch-size-product);
    }

    @media only screen and (max-width: 749px) {
      #Product--{{ section.id }} {
        --PT: {{ section.settings.padding_top_mobile }}px;
        --PB: {{ section.settings.padding_bottom_mobile }}px;
      }
    }
  {%- endstyle -%}

  <script src="{{ 'product.js' | asset_url }}" defer="defer"></script>
  {%- if product_sticky_enable -%}
    <script src="{{ 'product-sticky.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'novel-embed.js' | asset_url }}" defer="defer"></script>
  {%- endif -%}

  <{{ wrapper_tag }}
  class="product__wrapper {{ product_wrapper_modifier }}"
  data-product>
    {%- if navigation_content != blank -%}
      {{ navigation_content }}

      {%- assign animation_order = animation_order | plus: 1 -%}
    {%- endif -%}

    <div class="product__wrapper__inner">
      <div class="product__page">

        <div class="product__page-gallery"
        >
          {%- render 'product-gallery',
            section: section,
            unique: unique,
            product: product,
            badges_content: badges_content,
            product_images_classlist: product_images_classlist,
            enable_thumbs: enable_thumbs,
            enable_thumbs_mobile: enable_thumbs_mobile,
            show_thumbnails: show_thumbnails
          -%}
        </div>

        {%- assign animation_order = animation_order | plus: 1 -%}

        <div class="product__content"
        >
          <div
            class="form__wrapper{% unless show_buy_buttons %} form__wrapper--no-buttons{% endunless %}{% unless current_variant.available %} variant--soldout{% endunless %}{% if settings.form_style == 'classic' %} form__wrapper--classic{% else %} form__wrapper--modern{% endif %}{% if settings.show_newsletter %} show-product-notification{% endif %}"
            data-form-wrapper>

            <div class="form__width">
              {% comment %} The input with name="id" submits to cart {% endcomment %}
              <input type="hidden" name="id" value="{{ current_variant.id }}" form="{{ product_form_id }}">

              {% comment %} Add a line item property called 'Preorder' to preorder products {% endcomment %}
              {%- if preorder -%}
                <input
                  type="hidden"
                  name="properties[{{ 'products.product.sale_type' | t }}]"
                  value="{{ 'products.product.pre_order' | t }}"
                  form="{{ product_form_id }}"
                  data-product-preorder
                >
              {%- endif -%}

              {%- for block in section.blocks -%}
                {%- liquid
                  assign padding_bottom = block.settings.padding_bottom
                  assign padding_bottom_mobile = block.settings.padding_bottom_mobile
                  assign bg_accent = block.settings.bg_color
                  assign icon_size = block.settings.icon_size

                  capture block_style
                    if padding_bottom
                      echo '--block-padding-bottom: ' | append: padding_bottom | append: 'px;'
                      echo '--block-padding-bottom-mobile: ' | append: padding_bottom_mobile | default: padding_bottom | append: 'px;'
                    endif

                    if block.type == 'complementary-products'
                      unless bg_accent == 'rgba(0,0,0,0)' or bg_accent == blank
                        echo '--bg-accent: ' | append: bg_accent | append: ';'
                      endunless
                    endif

                    if icon_size
                      echo '--icon-size:' | append: icon_size | append: 'px;'
                    endif
                  endcapture

                  if block_style != blank
                    assign block_style = 'style="' | append: block_style | append: '"'
                  endif
                -%}

                {%- case block.type -%}
                  {%- when '@app' -%}
                    {%- assign assign next_index = forloop.index0 | plus: 1-%}
                    {%- assign next_block = section.blocks[next_index] -%}
                    {%- assign price_block_content = '' -%}

                    {%- if next_block.type contains 'price' -%}
                      {%- assign has_price = true -%}

                      {% capture price_block_content %}
                        {%- render 'product-price',
                          product: product,
                          unique: unique,
                          block: next_block,
                          block_style: block_style,
                          onboarding_product: onboarding_product,
                          product_form_id: product_form_id,
                          hide_shop_pay_terms: true
                        -%}
                      {% endcapture %}

                      {% liquid
                        capture block_style
                          assign padding_bottom = next_block.settings.padding_bottom
                          assign padding_bottom_mobile = next_block.settings.padding_bottom_mobile

                          if padding_bottom
                            echo '--block-padding-bottom: ' | append: padding_bottom | append: 'px;'
                            echo '--block-padding-bottom-mobile: ' | append: padding_bottom_mobile | default: padding_bottom | append: 'px;'
                          endif
                        endcapture
                      %}
                    {%- endif -%}

                    {%- if price_block_content != blank -%}
                      <div class="product__block product__block-with-price block-padding" style="{{ block_style }}">
                        {{- price_block_content -}}

                        <a class="scroll-to" href="#judgeme_product_reviews">
                          {%- render block -%}
                        </a>
                      </div>
                    {%- else -%}
                      {%- render block -%}
                    {%- endif -%}
                  {%- when 'title' -%}
                    {%- render 'product-title',
                      product: product,
                      block: block,
                      block_style: block_style,
                      is_title_linked: is_title_linked,
                      onboarding_product: onboarding_product,
                    -%}
                  {%- when 'note' -%}
                    {%- if block.settings.note != blank -%}
                      <p class="product__block product__note block-padding"
                        {{ block.shopify_attributes }} {{ block_style }}
                      >
                        {%- if block.settings.note contains 'Mix and Match. Pick ANY 10 Flavors!' -%}
                          10 single-serve packets | Up to 10 flavors
                        {%- else -%}
                          {{ block.settings.note }}
                        {%- endif -%}
                      </p>
                    {%- endif -%}
                  {%- when 'price' -%}
                    {%- unless has_price -%}
                      {%- assign has_price = false -%}

                      {% assign bundle_object = product.metafields.bundle.metaobject.value %}
                      {% assign threshold_value = bundle_object.threshold_value | default: 0 %}

                      {% if template.suffix == "bundle" and bundle_object and threshold_value != blank and threshold_value > 0 %}
                        <div class="product__block block-padding" {{ block_style }}>
                          <div class="product__price__wrap">
                            {%- assign bundle_price_prefix = 'products.product.bundle_price_prefix' | t -%}
                            {%- assign bundle_price_suffix = 'products.product.bundle_price_suffix' | t -%}

                            {%- if bundle_price_prefix != blank -%}
                              <span class="product__price--prefix">{{ 'products.product.bundle_price_prefix' | t }}</span>
                            {%- endif -%}

                            <div class="product__price body-x-large" data-price-wrapper="">
                              <span class="hidden" data-product-price="" data-form="{{ product_form_id }}">{{ current_variant.price | money }}</span>
                              <span data-product-price="">{{ threshold_value | money }}</span>

                              <span class="visually-hidden hidden" data-compare-text="">Regular price per packet</span>
                            </div>

                            {%- if bundle_price_suffix != blank -%}
                              <span class="product__price--suffix">{{ 'products.product.bundle_price_suffix' | t }}</span>
                            {%- endif -%}
                          </div>
                        </div>
                      {%- else -%}
                        {%- render 'product-price',
                          product: product,
                          unique: unique,
                          block: block,
                          block_style: block_style,
                          onboarding_product: onboarding_product,
                          product_form_id: product_form_id,
                          hide_shop_pay_terms: true
                        -%}
                      {%- endif -%}
                    {%- endunless -%}
                  {%- when 'variants' -%}
                    {%- render 'product-variant-options',
                      product: product,
                      unique: unique,
                      block: block,
                      block_style: block_style,
                      product_form_id: product_form_id,
                      enable_size_chart: true
                    -%}

                  {%- when 'buttons' -%}
                    {%- render 'product-buttons',
                      product: product,
                      current_variant: current_variant,
                      unique: unique,
                      block: block,
                      block_style: block_style,
                      product_form_id: product_form_id,
                      preorder: preorder,
                      onboarding_product: onboarding_product
                    -%}
                  {%- when 'description' -%}
                    {%- render 'product-description', product: product, block: block, block_style: block_style -%}

                  {%- when 'tab_richtext' -%}
                    {%- render 'product-description', product: product, block: block, block_style: block_style -%}

                  {%- when 'accordion' -%}
                    {%- render 'product-description', product: product, block: block, block_style: block_style -%}

                  {%- when 'inventory_countdown' -%}
                    {%- render 'product-inventory', product: product, block: block, block_style: block_style -%}

                  {%- when 'pickup' -%}
                    <pickup-availability
                      class="product__block product__pickup block-padding"
                      data-store-availability-container="{{ current_variant.id }}"
                      {{ block.shopify_attributes }}
                      {{ block_style }}
                    ></pickup-availability>

                    <script src="{{ 'pickup-availability.js' | asset_url }}" defer="defer"></script>

									{%- when 'subscriptions' -%}
										{%- if product.selling_plan_groups.size > 0 and block.settings.subscriptions_enable_selectors -%}
												<div
													class="product__block product__subscription block-padding"
													{{ block_style }}
													{% if animation_name %}
														data-animation="{{ animation_name }}"
														data-animation-duration="{{ animation_duration }}"
														data-animation-delay="{{ animation_delay }}"
													{% endif %}
													{{ block.shopify_attributes }}
												>
													{%- render 'subscription-form', product: product, product_form_id: product_form_id -%}

													{% comment %} Delete the following line to block the theme from updating subscription prices {% endcomment %}
													<span data-subscription-watch-price></span>

												</div>
										{%- endif -%}


                  {%- when 'code' -%}
                    <div
                      class="product__block product__custom-code block-padding"
                      {{ block_style }}
                      {{ block.shopify_attributes }}
                    >
                      {{ block.settings.code }}
                    </div>

                  {%- when 'siblings' -%}
                    {%- render 'product-siblings',
                      product: product,
                      product_form_id: product_form_id,
                      current_variant: current_variant,
                      block: block,
                      block_style: block_style,
                      quick_add_product: false
                    -%}
                  {%- when 'text' -%}
                    {%- render 'product-block-text', block: block, block_style: block_style -%}

                  {%- when 'icon' -%}
                    {%- render 'icon', block: block, index: forloop.index0, is_product: true -%}

                  {%- when 'sharing' -%}
                    <div class="product__block block-padding" {{ block.shopify_attributes }} {{ block_style }}>
                      {%- assign share_url = current_variant.url | prepend: request.origin -%}
                      {%- render 'share-button', share_url: share_url -%}
                    </div>

                  {%- when 'divider' -%}
                    {%- render 'divider', block: block, modifier: 'product__block product__block--divider' -%}

                  {%- when 'line-item' -%}
                    {%- render 'product-properties',
                      product: product,
                      block: block,
                      block_style: block_style,
                      unique: unique,
                      product_form_id: product_form_id
                    -%}

                  {%- when 'features' -%}
                    {%- liquid
                      assign block_id = block.id
                      assign text = block.settings.text
                      assign title = block.settings.title
                      assign prev_index = forloop.index0 | minus: 1
                      assign next_index = forloop.index0 | plus: 1
                      assign prev_block = section.blocks[prev_index]
                      assign next_block = section.blocks[next_index]
                      assign image = block.settings.icon_alt
                      assign bg_color = block.settings.bg_color
                      assign text_color = block.settings.color

                      comment
                        Always force dots style to be "line" except if "Circle" is chosen from the global settings
                      endcomment
                      assign dots_style = 'line'
                      if settings.dots_style == 'circle'
                        assign dots_style = 'circle'
                      endif

                      capture style
                        if bg_color != 'rgba(0,0,0,0)' and bg_color != blank
                          echo '--bg-accent: ' | append: bg_color | append: ';'
                        endif

                        if text_color != 'rgba(0,0,0,0)' and text_color != blank
                          echo '--text: ' | append: text_color | append: ';'
                        endif
                      endcapture
                    -%}

                    {%- if forloop.index0 == 0 or prev_block.type != 'features' -%}
                      <slider-component
                        class="product__block product__features block-padding"
                        {{ block_style }}
                        data-slider
                        data-slider-fullwidth
                        data-dots="{{ dots_style }}"
                        data-options='{"pageDots": true, "adaptiveHeight": true, "autoPlay": false, "prevNextButtons": false, "fade": false, "draggable": ">1"}'
                      >
                    {%- endif -%}

                    <div
                      class="product__feature"
                      data-slide="{{ block_id }}"
                      {% if style != blank %}
                        style="{{ style }}"
                      {% endif %}
                      {{ block.shopify_attributes }}
                    >
                      <div class="product__feature__content">
                        <div class="block__icon__container product__feature__heading">
                          {%- assign icon_size = block.settings.icon_size -%}
                          <div class="block__icon" style="--icon-size: {{ icon_size }}px;">
                            {%- liquid
                              if image
                                assign icon_width = icon_size
                                assign icon_width_retina = icon_width | times: 2
                                assign icon_sizes = icon_width | append: 'px'
                                assign icon_widths = icon_width | append: ', ' | append: icon_width_retina
                                render 'image', image: image, width: icon_width_retina, sizes: icon_sizes, widths: icon_widths, show_backfill: false
                              else
                                render 'animated-icon', filename: block.settings.icon_name
                              endif
                            -%}
                          </div>

                          {%- if title != blank -%}
                            <div class="block__icon__text {{ block.settings.text_font_size }}">
                              <p>{{ title }}</p>
                            </div>
                          {%- endif -%}
                        </div>

                        {%- if text != blank -%}
                          <div class="rte">
                            {{ text }}
                          </div>
                        {%- endif -%}
                      </div>
                    </div>

                    {%- if forloop.index == section.blocks.size or next_block.type != 'features' -%}
                      </slider-component>
                    {%- endif -%}

                  {%- when 'popup' -%}
                    {%- render 'product-popup', block: block -%}

                  {%- when 'complementary-products' -%}
                    <div
                      class="product__block product__complementary block-padding"
                      {{ block.shopify_attributes }}
                      {{ block_style }}
                    >
                      <complementary-products
                        class="complementary-products"
                        data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit=10&intent=complementary"
                      >
                        {%- if recommendations.performed and recommendations.products_count > 0 -%}
                          {%- assign complementary_products_title = 'products.general.complementary_products_title'
                            | t
                          -%}
                          {%- if complementary_products_title != blank -%}
                            <p class="complementary-products__title">{{ complementary_products_title }}</p>
                          {%- endif -%}

                          {%- for product in recommendations.products limit: block.settings.complementary_limit -%}
                            {%- render 'upsell-product', upsell_product: product -%}
                          {%- endfor -%}
                        {%- endif -%}
                      </complementary-products>
                    </div>

                    <script src="{{ 'complementary-products.js' | asset_url }}" defer="defer"></script>

                  {%- when 'badges' -%}
                    {%- unless block.settings.product_badges_over_image or badges_content == blank -%}
                      <div
                        class="product__block badge--container block-padding"
                        {{ block.shopify_attributes }}
                        {{ block_style }}
                      >
                        {{ badges_content }}
                      </div>
                    {%- endunless -%}

                    {%- if block.settings.product_type -%}
                      {% capture product_type_capture %}
                        {%- for tag in product.tags -%}
                          {%- if tag contains '_type' -%}
                            {{- tag | replace: '_type:' -}}
                            {%- break -%}
                          {%- endif -%}
                        {%- endfor -%}
                      {% endcapture %}

                      {%- if product_type_capture != blank -%}
                        <div class="product__block product__type block-padding"
                          {{ block.shopify_attributes }}
                          {{ block_style }}
                        >
                          <span class="product-item__type">{{ product_type_capture }}</span>
                        </div>
                      {%- endif -%}
                    {%- endif -%}
                  {%- when 'fit-guide' -%}
                    {%- liquid
                      assign fit_color = block.settings.fit_color
                      unless fit_color.alpha == 0.0 or fit_color == blank
                        capture style
                          echo '--text:' | append: fit_color
                        endcapture
                      endunless
                    -%}

                    <div
                      class="product__block product__guide guide block-padding"
                      {{ block.shopify_attributes }}
                      {{ block_style }}
                    >
                      {%- if block.settings.heading != blank -%}
                        <p class="guide__heading strong">{{ block.settings.heading }}</p>
                      {%- endif -%}

                      <div class="guide__line" style="{{ style }}">
                        {%- assign selected_segment = block.settings.selected_segment | plus: 0 -%}
                        {%- for idx in (1..5) -%}
                          <span
                            {% if forloop.index == selected_segment %}
                              class="is-active"
                            {% endif %}
                          >
                            {{- forloop.index -}}
                          </span>
                        {%- endfor -%}
                      </div>

                      {%- if block.settings.left_label != blank
                        or block.settings.middle_label != blank
                        or block.settings.right_label != blank
                      -%}
                        <div class="guide__content{% unless block.settings.left_label != blank %} guide__content--skip-left{% endunless %}{% unless block.settings.right_label != blank %} guide__content--skip-right{% endunless %}">
                          {%- if block.settings.left_label != blank -%}
                            <small class="guide__left">{{ block.settings.left_label }}</small>
                          {%- endif -%}

                          {%- if block.settings.middle_label != blank -%}
                            <small class="guide__middle">{{ block.settings.middle_label }}</small>
                          {%- endif -%}

                          {%- if block.settings.right_label != blank -%}
                            <small class="guide__right">{{ block.settings.right_label }}</small>
                          {%- endif -%}
                        </div>
                      {%- endif -%}
                    </div>
                  {%- when 'bundle' -%}
                    <script src="{{ 'bundle.js' | asset_url }}" defer="defer"></script>
                    {{ 'bundle.css' | asset_url | stylesheet_tag }}

                    {% liquid
                      assign bundle_object = product.metafields.bundle.metaobject.value
                      assign bundle_object_type = bundle_object.system.type
                      assign bundle_variants_limit = bundle_object.product_variants_limit
                      assign bundle_discount_percent = bundle_object.bundle_discount_percent

                      if bundle_object_type contains 'bundle_radio'
                        assign selection_type = 'single'
                      elsif bundle_variants_limit != null
                        assign selection_type = 'limitation'
                      endif

                      assign accordion_opent_state = bundle_object.accordion_state
                      assign threshold_value = bundle_object.threshold_value | default: 0
                      assign defined_block_variants = bundle_object.defined_block_variants

                      assign first_block_title = bundle_object.first_block_title
                      assign first_block_badge = bundle_object.first_block_badge_label
                      assign first_block_variants = bundle_object.first_block_variants

                      assign second_block_title = bundle_object.second_block_title
                      assign second_block_badge = bundle_object.second_block_badge_label
                      assign second_block_variants = bundle_object.second_block_variants

                      capture define_block_card_product
                        assign defined_block_variants_available = defined_block_variants.value | where: 'available', true
                        assign defined_block_variants_not_available = defined_block_variants.value | where: 'available', false
                        assign defined_block_variants = defined_block_variants_available | concat: defined_block_variants_not_available

                        for defined_block_variant in defined_block_variants
                          unless defined_block_variant.product == empty or product_ids contains defined_block_variant.id
                            assign product_ids = product_ids | append: ',' | append: defined_block_variant.id

                            if defined_block_variant.available
                              assign initial_quantity = 1
                            else
                              assign initial_quantity = 0
                            endif

                            assign product_index = product_index | plus: 1
                            render 'card-product-bundle', variant: defined_block_variant, product_form_id: product_form_id, index: product_index, initial_quantity: initial_quantity, defined_product: true, bundle_discount_percent: bundle_discount_percent
                          endunless
                        endfor
                      endcapture

                      capture first_block_card_product
                        assign first_block_variants_available = first_block_variants.value | where: 'available', true
                        assign first_block_variants_not_available = first_block_variants.value | where: 'available', false
                        assign first_block_variants = first_block_variants_available | concat: first_block_variants_not_available

                        for first_block_variant in first_block_variants
                          unless first_block_variant.product == empty or product_ids contains first_block_variant.id
                            assign product_ids = product_ids | append: ',' | append: first_block_variant.id

                            if selection_type contains 'single'
                              if first_block_variant.available and selected_item == nil
                                assign initial_quantity = 1
                                assign selected_item = true
                              else
                                assign initial_quantity = 0
                              endif
                            else
                              assign initial_quantity = 0
                            endif

                            assign product_index = product_index | plus: 1
                            render 'card-product-bundle', variant: first_block_variant, product_form_id: product_form_id, index: product_index, threshold_value: threshold_value, selection_type: selection_type, initial_quantity: initial_quantity, bundle_variants_limit: bundle_variants_limit, bundle_discount_percent: bundle_discount_percent
                          endunless
                        endfor
                      endcapture

                      capture second_block_card_product
                        assign second_block_variants_available = second_block_variants.value | where: 'available', true
                        assign second_block_variants_not_available = second_block_variants.value | where: 'available', false
                        assign second_block_variants = second_block_variants_available | concat: second_block_variants_not_available

                        for second_block_variant in second_block_variants
                          unless second_block_variant.product == empty or product_ids contains second_block_variant.id
                            assign product_index = product_index | plus: 1

                            render 'card-product-bundle', variant: second_block_variant, product_form_id: product_form_id, index: product_index, threshold_value: threshold_value, selection_type: selection_type, initial_quantity: initial_quantity, bundle_variants_limit: bundle_variants_limit, bundle_discount_percent: bundle_discount_percent
                          endunless
                        endfor
                      endcapture

                      if selection_type contains 'limitation'
                        assign bundle_products_counter = bundle_variants_limit
                      else
                        assign bundle_products_counter = product_index
                      endif
                    -%}

                  {%- if bundle_products_counter > 0 and bundle_object_type contains 'bundle_quantity'  -%}
                    {%- assign animation_order = animation_order | plus: 1 -%}
                    <bundle-block
                      class="product__block product__bundle product-bundle block-padding"
                      data-product-form-id="{{ product_form_id }}"
                      data-parent-variant-id="{{ product.variants[0].id }}"
                      data-product-price="{{ product.variants[0].price }}"
                      data-calculate-price="true"
                      {% if bundle_discount_percent != nil %}
                        data-bundle-discount-percent="{{ bundle_discount_percent }}"
                      {% endif %}
                      {{ block.shopify_attributes }}
                      {{ block_style }}
                      data-aos="hero"
                      data-aos-anchor="{{ animation_anchor }}"
                      data-aos-order="{{ animation_order }}"
                    >

                      <div class="product-bundle__header">
                        <h6 class="product-bundle__heading">{{ block.settings.heading }}</h6>
                        <div class="product-bundle__info">
                          <span class="product-bundle__info-label">
                            {{ block.settings.label }}
                          </span>
                          <span class="product-bundle__counter" data-counter>
                            0/{{ bundle_products_counter }}
                          </span>
                        </div>
                      </div>

                      <div class="product-bundle__contents">
                        {%- comment -%} <div class="product-bundle__contents-inner"></div>{%- endcomment -%}

                        {%- if define_block_card_product != empty -%}
                          <div class="product-bundle__block">
                            <div class="product-bundle__block-content">
                              {{ define_block_card_product }}
                            </div>
                          </div>
                        {%- endif -%}

                        {%- comment -%}
                          {%- if define_block_card_product != empty -%}
                            <div class="product-bundle__accordion">
                              <collapsible-elements single="true">

                                <details class="accordion" data-collapsible
                                  {% if accordion_opent_state %}
                                    open="true"
                                  {% endif %}
                                >
                                  <summary class="accordion__title product-bundle__accordion-toggle" data-collapsible-trigger>
                                    Defined block

                                    {%- render 'icon-chevron-down' -%}
                                  </summary>

                                  <div class="accordion__body rte"{% if accordion_opent_state != blank %} style="height: auto;"{% endif %} data-collapsible-body>
                                    <div class="accordion__content product-bundle__accordion-content" data-collapsible-content>
                                      {{ define_block_card_product }}
                                    </div>
                                  </div>
                                </details>
                              </collapsible-elements>
                            </div>
                          {%- endif -%}
                        {%- endcomment -%}

                        {%- if first_block_card_product != empty and second_block_card_product != blank -%}
                          {%- if first_block_card_product != empty -%}
                            {% assign first_block_title = first_block_title | default: 'First block:' %}

                            <div class="product-bundle__accordion">
                              <collapsible-elements single="true">

                                <details class="accordion" data-collapsible
                                  {% if accordion_opent_state %}
                                    open="true"
                                  {% endif %}
                                >
                                  <summary class="accordion__title product-bundle__accordion-toggle" data-collapsible-trigger>
                                    {{ first_block_title }} {%- if first_block_badge != blank -%}<span class="product-bundle__badge">{{ first_block_badge }}</span>{%- endif -%}

                                    {%- render 'icon-chevron-down' -%}
                                  </summary>

                                  <div class="accordion__body rte"{% if accordion_opent_state != blank %} style="height: auto;"{% endif %} data-collapsible-body>
                                    <div class="accordion__content product-bundle__accordion-content" data-collapsible-content>
                                      {{ first_block_card_product }}
                                    </div>
                                  </div>
                                </details>
                              </collapsible-elements>
                            </div>
                          {%- endif -%}

                          {%- comment -%}
                            <div class="product-bundle__separator"></div>
                          {%- endcomment -%}

                          {%- if second_block_card_product != empty -%}
                            {% assign second_block_title = second_block_title | default: 'Second block:' %}

                            <div class="product-bundle__accordion">
                              <collapsible-elements single="true">
                                <details class="accordion" data-collapsible
                                  {% if accordion_opent_state %}
                                    open="true"
                                  {% endif %}>


                                  <summary class="accordion__title product-bundle__accordion-toggle" data-collapsible-trigger>
                                    {{ second_block_title }} {%- if second_block_badge != blank -%}<span class="product-bundle__badge">{{ second_block_badge }}</span>{%- endif -%}

                                    {%- render 'icon-chevron-down' -%}
                                  </summary>

                                  <div class="accordion__body rte"{% if accordion_opent_state != blank %} style="height: auto;"{% endif %} data-collapsible-body>
                                    <div class="accordion__content product-bundle__accordion-content" data-collapsible-content>
                                      {{ second_block_card_product }}
                                    </div>
                                  </div>
                                </details>
                              </collapsible-elements>
                            </div>

                            <div class="product-bundle__contents-footer">
                              <div class="product-bundle__contents-footer-inner">
                                <p>{{ second_block_title }} Added: <span class="product-bundle__contents-footer-counter" data-contents-footer-counter>0</span></p> <span class="product-bundle__contents-footer-price" data-contents-footer-price></span>
                              </div>
                            </div>
                          {%- endif -%}
                        {%- else -%}
                          {%- assign current_block_card_product = first_block_card_product | default: second_block_card_product -%}
                          {%- assign current_block_title = first_block_title | default: second_block_title -%}
                          {%- assign current_block_badge = first_block_badge | default: second_block_badge -%}

                          {%- if current_block_card_product != empty -%}
                            <div class="product-bundle__block">
                              {%- if current_block_title != blank -%}<p class="product-bundle__block-title">{{ current_block_title }} {%- if current_block_badge != blank -%}<span class="product-bundle__badge">{{ current_block_badge }}</span>{%- endif -%}</p>{%- endif -%}

                              <div class="product-bundle__block-content">
                                {{ current_block_card_product }}
                              </div>
                            </div>
                          {%- endif -%}
                        {%- endif -%}
                      </div>
                    </bundle-block>
                  {%- elsif bundle_products_counter > 0 and bundle_object_type contains 'bundle_radio' -%}
                    {%- assign animation_order = animation_order | plus: 1 -%}
                    {%- assign parentVariantId = product.variants[0].id -%}

                      <bundle-block
                        class="product__block product__bundle product-bundle block-padding developer1"
                        data-product-form-id="{{ product_form_id }}"
                        data-parent-variant-id="{{ product.variants[0].id }}"
                        data-product-price="{{ product.variants[0].price }}"
                        data-calculate-price="true"
                        {% if bundle_discount_percent != nil %}
                          data-bundle-discount-percent="{{ bundle_discount_percent }}"
                        {% endif %}
                        {{ block.shopify_attributes }}
                        {{ block_style }}
                        data-aos="hero"
                        data-aos-anchor="{{ animation_anchor }}"
                        data-aos-order="{{ animation_order }}"
                      >

                      <div class="product-bundle__header">
                        <h6 class="product-bundle__heading">{{ block.settings.heading }}</h6>
                        <div class="product-bundle__info {%- if selection_type contains 'single' %} visually-hidden{%- endif -%}">
                                <span class="product-bundle__info-label">
                                  {{ block.settings.label }}
                                </span>
                          <span class="product-bundle__counter" data-counter>
                                  0/{{ bundle_products_counter }}
                                </span>
                        </div>
                      </div>

                      <div class="product-bundle__contents">
                        {%- if define_block_card_product != empty -%}
                          <div class="product-bundle__block">
                            <div class="product-bundle__block-content">
                              {{ define_block_card_product }}
                            </div>
                          </div>

                          {%- comment -%}
                            <div class="product-bundle__separator"></div>
                          {%- endcomment -%}
                        {%- endif -%}

                        {%- assign current_block_card_product = first_block_card_product | default: second_block_card_product -%}
                        {%- assign current_block_title = first_block_title | default: second_block_title -%}
                        {%- assign current_block_badge = first_block_badge | default: second_block_badge -%}

                        {%- if first_block_card_product != empty -%}
                          <div class="product-bundle__block">
                            {%- if first_block_title != blank -%}
                              <p class="product-bundle__block-title">{{ first_block_title }}
                              {%- if first_block_badge != blank -%}<span class="product-bundle__badge">{{ first_block_badge }}</span>{%- endif -%}
                              </p>
                            {%- endif -%}

                            <div class="product-bundle__block-content">
                              {{ first_block_card_product }}
                            </div>
                          </div>
                        {%- endif -%}
                      </div>
                    </bundle-block>
                  {%- endif -%}
                {%- when 'novel-embed' -%}
                  {%- assign novel_embed_id  = block.settings.id -%}

                  {%- if novel_embed_id != blank -%}
                    <div class="product__block product__custom-novel-embed block-padding"
                      {{ block_style }}
                      {{ block.shopify_attributes }}>
                      <novel-embed data-journey-id="{{ novel_embed_id }}"></novel-embed>
                    </div>
                    <script src="{{ 'novel-embed.js' | asset_url }}" defer="defer"></script>
                  {%- endif -%}
                {%- endcase -%}
              {%- endfor -%}
            </div>
          </div>
        </div>
      </div>
    </div>
  </{{ wrapper_tag }}>

  {% unless product == empty %}
    <script type="application/json" data-product-json>
      {{ product | json }}
    </script>
    <script type="application/json" id="ModelJSON-{{ unique }}">
      {{ product.media | where: 'media_type', 'model' | json }}
    </script>

    {%- liquid
      assign metafields_data = '['
      for variant in product.variants
        assign metafield_value = variant.metafields.theme.final_sale.value | replace: '"', "''"
        assign metafields_data = metafields_data | append: '{"variant_id":"' | append: variant.id | append: '" , "metafield_value":"' | append: metafield_value | append: '"},'
      endfor
      assign metafields_data = metafields_data | append: ']'
      assign metafields_data = metafields_data | replace: ',]', ']'
    -%}

    <span data-variant-final-sale-metafield style="display:none;">{{ metafields_data }}</span>
  {% endunless %}

  {%- if show_cart_bar -%}
    {%- render 'cart-bar', product: product -%}
  {%- endif -%}
</product-component>