{% comment %}
  {% render 'cart-promotion-block', promotion_block: block %}
{% endcomment %}

{% liquid
	assign promotion_title = promotion_block[0].settings.title
	assign promotion_product = promotion_block[0].settings.product
	assign promotion_current_variant = promotion_product.selected_or_first_available_variant
	assign promotion_image = promotion_block[0].settings.image
	assign promotion_add_image = promotion_block[0].settings.promotion_image
	assign promotion_bg_color = promotion_block[0].settings.bg_color
	assign promotion_text_color = promotion_block[0].settings.text_color

	assign bundle_object = promotion_product.metafields.bundle.metaobject.value

	assign defined_block_variants = bundle_object.defined_block_variants
	assign defined_block_variants = defined_block_variants.value | where: 'available', true

	for variant in defined_block_variants
		if variant.product.tags contains 'bundle_free_product'
			assign variant_free_product = variant
		endif
	endfor

	assign first_block_variants = bundle_object.first_block_variants
	assign first_block_variants = first_block_variants.value | where: 'available', true

	assign sold_out = false

	if first_block_variants.size == 0
		assign sold_out = true
	endif
%}
<div class="promotion-block__wrapper" style="--bg: {{ promotion_bg_color }}; --text: {{ promotion_text_color }};">
	<p class="promotion-block__title">{{ promotion_title }}</p>
	<div class="promotion-block__product-wrapper">
		<div class="promotion-block__product-image" data-product-image>
			{% if promotion_add_image != blank %}
				<div class="promotion-block__product-add-image">
					{% render 'image', image: promotion_add_image, aspect_ratio: 1, sizes: sizes, widths: widths, loading: loading, fetchpriority: fetchpriority, preload: preload, attributes: image_animations, cover: true, preload_with_skeleton: true %}
				</div>
			{% endif %}
			<a
				class="promotion-block__product-link"
				href="{{ product.url }}"
				aria-label="{{ product.title | strip_html | escape }}"
				data-product-link="{{ product.url }}"
			>
				{%- if product.media.size > 0 or promotion_image != blank -%}
					<div class="promotion-block__product-bg" data-product-image-default>
						{%- liquid
							assign fetchpriority = 'auto'
							assign preload = false
							assign image = promotion_image | default: promotion_product.featured_media.preview_image

							capture featured_image
								render 'image', image: image, aspect_ratio: 1, sizes: sizes, widths: widths, loading: loading, fetchpriority: fetchpriority, preload: preload, attributes: image_animations, cover: true, preload_with_skeleton: true
							endcapture
						-%}

						{{ featured_image }}
					</div>
				{%- endif -%}
			</a>
		</div>

		<div class="promotion-block__product-info">
			<ul class="promotion-block__product-items">
				{%- for defined_block_variant in defined_block_variants  -%}
					{% if defined_block_variant.product.tags contains 'bundle_free_product' %}
						{% continue %}
					{% else %}
						<li class="promotion-block__product-item">
							<span>{{ defined_block_variant.product.title }}</span>
							<span>({{ defined_block_variant.price | money }})</span>
						</li>
					{% endif %}
				{%- endfor -%}
				{% if first_block_variants.size > 0 %}
					<li class="promotion-block__product-item">
						<span>{{ first_block_variants[0].product.title }}</span>
						<span>({{ first_block_variants[0].price | money }})</span>
					</li>
				{% endif %}
			</ul>
			{% if variant_free_product %}
				<div class="promotion-block__product-item--free">
					<svg xmlns="http://www.w3.org/2000/svg" width="18" height="19" viewBox="0 0 18 19" fill="none" class="icon icon--gift">
						<path d="M15.1875 6.125H2.8125C2.50184 6.125 2.25 6.37684 2.25 6.6875V8.9375C2.25 9.24816 2.50184 9.5 2.8125 9.5H15.1875C15.4982 9.5 15.75 9.24816 15.75 8.9375V6.6875C15.75 6.37684 15.4982 6.125 15.1875 6.125Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
						<path d="M14.625 9.5V14.5625C14.625 14.7117 14.5657 14.8548 14.4602 14.9602C14.3548 15.0657 14.2117 15.125 14.0625 15.125H3.9375C3.78832 15.125 3.64524 15.0657 3.53975 14.9602C3.43426 14.8548 3.375 14.7117 3.375 14.5625V9.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
						<path d="M9 6.125V15.125" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
						<path d="M12.4305 2.69464C13.0873 3.35136 13.1259 4.45668 12.4305 5.07261C11.2416 6.12519 9 6.12519 9 6.12519C9 6.12519 9 3.88363 10.0547 2.69464C10.6685 1.99925 11.7738 2.03793 12.4305 2.69464Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
						<path d="M5.56964 2.69464C4.91293 3.35136 4.87425 4.45668 5.56964 5.07261C6.75863 6.12519 9.00019 6.12519 9.00019 6.12519C9.00019 6.12519 9.00019 3.88363 7.9455 2.69464C7.33168 1.99925 6.22636 2.03793 5.56964 2.69464Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
					</svg>
					<span>{{ variant_free_product.product.title }}</span>
					<span>({{ variant_free_product.price | money }})</span>
				</div>
			{% endif %}
			<quick-add-product>
				<div class="quick-add__holder" data-quick-add-holder="{{ promotion_product.id }}">
					{%- assign product_form_id = 'ProductForm--' | append: promotion_product.id -%}
					<form method="post" action="/cart/add" id="{{ product_form_id }}" accept-charset="UTF-8" class="shopify-product-form" enctype="multipart/form-data">
						<input type="hidden" name="form_type" value="product" class="">
						<input type="hidden" name="utf8" value="✓" class="">
						<input type="hidden" name="section-id" value="{{ section.id }}" class="">


						{% liquid
							assign bundle_selection = ''
							assign product_index = 0
						%}

						{%- assign formatted_variants = '' -%}
						{%- for variant in defined_block_variants -%}
							{%- assign variant_id = variant.id | append: ':1' -%}
							{%- if forloop.first -%}
								{%- assign formatted_variants = variant_id -%}
							{%- else -%}
								{%- assign formatted_variants = formatted_variants | append: ', ' | append: variant_id -%}
							{%- endif -%}
						{%- endfor -%}

						{%- assign formatted_variants = formatted_variants | append: ', ' | append: first_block_variants[0].id | append: ':1' -%}

						{%- for defined_block_variant in defined_block_variants -%}
							{%- assign bundle_selection = defined_block_variant.product.title | append:  '<>' -%}
							{% assign product_index = product_index | plus: 1 %}
							<input type="hidden" name="items[{{ forloop.index }}][id]" value="{{ defined_block_variant.id }}" />
							<input type="hidden" name="items[{{ forloop.index }}][quantity]" value="1" />
							<input type="hidden" name="items[{{ forloop.index }}][properties][_bundlePackages]" value="{{ formatted_variants }}"/>
							<input type="hidden" name="items[{{ forloop.index }}][properties][_bundleParentVariantId]" value="{{ promotion_product.variants[0].id }}"/>
						{%- endfor -%}
						<input type="hidden" name="items[{{ product_index | plus: 1 }}][id]" value="{{ first_block_variants[0].id }}" />
						<input type="hidden" name="items[{{ product_index | plus: 1 }}][quantity]" value="1" />
						<input type="hidden" name="items[{{ product_index | plus: 1 }}][properties][_bundlePackages]" value="{{ formatted_variants }}"/>
						<input type="hidden" name="items[{{ product_index | plus: 1 }}][properties][_bundleParentVariantId]" value="{{ promotion_product.variants[0].id }}"/>

						<button class="quick-add__button btn btn--primary"
										type="submit"
										name="add"
										data-add-to-cart
							{% if sold_out != true %}
								aria-label="{{ 'products.general.upsell_add_to_cart' | t }}"
							{% else %}
								disabled
								aria-label="{{ 'products.product.sold_out' | t }}"
							{% endif %}
						>
															<span class="btn__text">
																{% if sold_out != true %}
																	{{ 'products.general.upsell_add_to_cart' | t }}
																{% else %}
																	{{ 'products.product.sold_out' | t }}
																{% endif %}
															</span>

							<span class="btn__added">&nbsp;</span>
							<span class="btn__loader">
																<svg height="18" width="18" class="svg-loader">
																	<circle r="7" cx="9" cy="9" />
																	<circle stroke-dasharray="87.96459430051421 87.96459430051421" r="7" cx="9" cy="9" />
																</svg>
															</span>
							<span class="btn__error" data-message-error>&nbsp;</span>
						</button>
					</form>
				</div>
			</quick-add-product>
		</div>
	</div>
</div>